{
  "name": "tuna-hue",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bgproc start -n tuna-hue-website -w 20 -- bun --filter @tuna-hue/website dev --ignore-lock",
    "build": "bun --filter @tuna-hue/website build",
    "preview": "bun --filter @tuna-hue/website preview",
    "build:plugin": "bun --filter @tuna-hue/plugin build",
    "install:plugin": "bash scripts/install-dev.sh",
    "install-dev": "bun run build:plugin && bun run install:plugin",
    "package:plugin": "bash scripts/package-plugin.sh",
    "screenshots": "bash scripts/screenshots/proof.sh --publish",
    "screenshots:proof": "bash scripts/screenshots/proof.sh"
  }
}
