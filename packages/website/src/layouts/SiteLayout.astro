---
import AmbientBackground from '../components/AmbientBackground.astro';

interface Props {
  ambientLighting?: boolean;
  title: string;
  description: string;
}

const { ambientLighting, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const installPath = base + '/install/';
const onInstallPage = Astro.url.pathname.replace(/\/$/, '') === base + '/install';
const repository = 'https://github.com/bjesuiter/tuna-hue';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <header>
        <a class="wordmark" href={base + '/'}><span class="mark" aria-hidden="true"></span>Tuna Hue Control</a>
        <nav aria-label="Main">
          <a href={installPath} aria-current={onInstallPage ? 'page' : undefined}>Get started</a>
          <a class="github" href={repository}>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
            </svg>
            GitHub
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M3 9 9 3M4 3h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </nav>
      </header>
      {ambientLighting && <AmbientBackground />}

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    :root { scroll-behavior: smooth; }
  }

  :root {
    color-scheme: light;
    --paper: #fff;
    --ink: #16151a;
    --muted-ink: #595665;
    --line: #dedce4;
    --accent: #faf0eb;
    --soft-shadow: 0 16px 40px -24px #a76f8370, 0 12px 32px -24px #edb19a80;
    --heading-font: 'Avenir Next', system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    font: 1rem/1.5 'Avenir Next', system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; }
  body, p, h1 { margin: 0; }
  body { isolation: isolate; }
  button { font: inherit; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid #6646d3; outline-offset: 5px; }

  .page { max-width: 90rem; margin-inline: auto; padding-inline: clamp(1.25rem, 5vw, 5rem); }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: 5rem;
    gap: .35rem 1rem;
    padding-block: .55rem;
    border-bottom: 1px solid var(--line);
  }
  header a { text-decoration: none; font-weight: 650; font-size: .875rem; }
  header a:hover { text-decoration: underline; }
  header nav { display: flex; align-items: center; justify-content: flex-end; flex: 1 0 auto; gap: clamp(.75rem, 3vw, 1.75rem); }
  header [aria-current="page"] { text-decoration: underline; text-underline-offset: .3em; }
  .github { display: inline-flex; gap: .45rem; align-items: center; }
  .wordmark { display: inline-flex; gap: .65rem; align-items: center; }
  .mark {
    width: 1.1rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid #c2b7d0;
    box-shadow: 0 4px 12px #aca1d85c;
    background: conic-gradient(#f4c6e3, #cec9f7, #c7ebec, #f9eccb, #f4c6e3);
  }

  .page:has([data-light-demo][data-lit="false"]) {
    --page-saturation: 0;
    --ambient-opacity: .24;
  }

  header, main { filter: saturate(var(--page-saturation, 1)); }

  @media (prefers-reduced-motion: no-preference) {
    header, main { transition: filter 450ms ease; }
  }

  @media (max-width: 48rem) {
    header { min-height: 3.8rem; }
  }
</style>
