---
import { Font } from 'astro:assets';
import AmbientBackground from '../components/AmbientBackground.astro';
import LampGlobe from '../components/LampGlobe.astro';

interface Props {
  ambientLighting?: boolean;
  /** Keeps the page out of search results, for the 404 page. */
  noindex?: boolean;
  title: string;
  description: string;
}

const { ambientLighting, noindex, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isHome = currentPath === base;
const mainLinks = [
  { path: base + '/how-it-works', label: 'See how it works' },
  { path: base + '/install', label: 'Install now' },
  { path: base + '/privacy', label: 'Privacy' },
];
const repository = 'https://github.com/bjesuiter/tuna-hue';
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(base + '/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Font cssVariable="--font-geist" preload={[{ weight: '100 900' }]} />
    <Font cssVariable="--font-geist-mono" />
    <link rel="icon" href={base + '/favicon.svg'} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={base + '/apple-touch-icon.png'} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href={base + '/sitemap-index.xml'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tuna Hue Control" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tuna Hue Control: Lights at your fingertips. Tuna's launcher window with Living Room selected and the Turn Off action." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="oklch(100% 0 0)" />
    <script is:inline>
      if (new URLSearchParams(location.search).get('lamp') === 'off') {
        document.documentElement.dataset.lamp = 'off';
      }
    </script>
  </head>
  <body>
    <div class="page">
      <header>
        <div class="brand">
          {!isHome && (
            <button class="menu-lamp" type="button" aria-label="Living Room lights" aria-pressed="true" data-menu-lamp disabled>
              <LampGlobe />
            </button>
          )}
          <a href={base + '/'} data-lamp-link>Tuna Hue Control</a>
        </div>
        <nav aria-label="Main">
          <button class="menu-toggle pill" type="button" popovertarget="main-menu-links" aria-controls="main-menu-links" hidden>
            Menu
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="main-menu-links" class="menu-links">
            {mainLinks.map(({ path, label }) => (
              <a href={path + '/'} aria-current={currentPath === path ? 'page' : undefined} data-lamp-link>{label}</a>
            ))}
            <a class="github" href={repository}>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
              </svg>
              GitHub
              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M3 9 9 3M4 3h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            {ambientLighting && (
              <button class="motion-toggle" type="button" data-ambient-motion-toggle hidden>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path class="motion-pause" d="M5.5 3.5v9m5-9v9" />
                  <path class="motion-play" d="m5 3 7.5 5L5 13z" />
                </svg>
                <span>Pause motion</span>
              </button>
            )}
          </div>
        </nav>
      </header>
      {ambientLighting && <AmbientBackground />}

      <main>
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>

<script>
  import { setLamp, syncLampLinks, syncThemeColor } from '../components/lamp-state';

  syncLampLinks();
  syncThemeColor();

  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menuLinks = document.querySelector<HTMLElement>('#main-menu-links');
  const header = menuToggle?.closest('header');
  if (menuToggle && menuLinks && header && Object.hasOwn(HTMLElement.prototype, 'popover')) {
    const syncMenu = () => {
      const compact = getComputedStyle(menuToggle).getPropertyValue('--compact-menu').trim() === '1';
      if (compact === menuLinks.hasAttribute('popover')) return;

      menuToggle.hidden = !compact;
      if (compact) menuLinks.setAttribute('popover', 'auto');
      else menuLinks.removeAttribute('popover');
      menuLinks.classList.toggle('glass-panel', compact);
    };

    menuLinks.addEventListener('beforetoggle', event => {
      if ((event as ToggleEvent).newState !== 'open') return;

      const trigger = menuToggle.getBoundingClientRect();
      menuLinks.style.setProperty('--menu-top', `${trigger.bottom + window.scrollY}px`);
      menuLinks.style.setProperty('--menu-right-edge', `${trigger.right + window.scrollX}px`);
    });
    // Deferred: syncMenu resizes the header, which would re-trigger the observer in the same frame.
    new ResizeObserver(() => requestAnimationFrame(syncMenu)).observe(header);
    syncMenu();
  }

  const menuLamp = document.querySelector<HTMLButtonElement>('[data-menu-lamp]');
  if (menuLamp) {
    menuLamp.setAttribute('aria-pressed', String(document.documentElement.dataset.lamp !== 'off'));
    menuLamp.disabled = false;
    menuLamp.addEventListener('click', () => {
      const lit = document.documentElement.dataset.lamp === 'off';
      setLamp(lit);
      menuLamp.setAttribute('aria-pressed', String(lit));
    });
  }
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }

    :root { scroll-behavior: smooth; }

    ::view-transition-group(root) { animation-duration: 260ms; }

    .lamp-transition { view-transition-name: hue-lamp; }
    ::view-transition-group(hue-lamp) {
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(.22, 1, .36, 1);
    }
  }

  :root {
    color-scheme: light;
    scrollbar-gutter: stable;
    --paper: oklch(100% 0 0);
    --ink: oklch(19.91% 0.01 294.6);
    --muted-ink: oklch(46.15% 0.0243 294.6);
    --line: oklch(89.84% 0.011 297.6);
    --focus: oklch(51.29% 0.2049 287.3);
    --glass-panel: oklch(99.31% 0.0034 247.9 / 0.875);
    --glass-control: oklch(96.78% 0.0153 257.2 / 0.251);
    --glass-control-hover: oklch(96.78% 0.0153 257.2 / 0.439);
    --glass-control-glint: oklch(100% 0 0 / 0.329);
    --glass-edge: oklch(61.83% 0.0531 258 / 0.329);
    --glass-glint: oklch(100% 0 0 / 0.733);
    --backdrop: oklch(96% 0.01 259 / 0.96);
    --glass-shadow: 0 16px 38px -26px oklch(48.11% 0.0813 263.7 / 0.451), 0 3px 12px oklch(60.94% 0.0706 263.4 / 0.141);

    /* Spacing scale */
    --space-3xs: .25rem;
    --space-2xs: .5rem;
    --space-xs: .75rem;
    --space-s: 1rem;
    --space-m: 1.5rem;
    --space-l: 2rem;
    --space-xl: 3rem;
    --space-2xl: 4rem;
    --space-3xl: 6rem;

    /* Layout */
    --page-max: 90rem;
    --page-gutter: clamp(1.25rem, 5vw, 5rem);
    --page-block: clamp(var(--space-xl), 7vw, var(--space-3xl));
    --section-gap: clamp(var(--space-l), 5vw, var(--space-xl));
    --card-pad: clamp(var(--space-s), 3vw, var(--space-l));
    --card-radius: 1rem;
    --pill-radius: 2rem;
    --tap-target: 2.75rem;
    --header-height: 3.8rem;

    /* Type scale */
    --font-sans: var(--font-geist);
    --font-mono: var(--font-geist-mono);
    --text-xs: .75rem;
    --text-s: .875rem;
    --text-m: 1rem;
    --text-l: clamp(1.0625rem, 1rem + .4vw, 1.25rem);
    --text-xl: clamp(1.125rem, 1rem + .5vw, 1.375rem);
    --text-2xl: clamp(1.5rem, 1.2rem + 1.25vw, 2rem);
    --text-3xl: clamp(2.75rem, 1.5rem + 3vw, 4.5rem);
    --weight-semibold: 650;

    background: var(--paper);
    color: var(--ink);
    font: var(--text-m)/1.5 var(--font-sans);
  }

  *, *::before, *::after { box-sizing: border-box; }
  body, p, h1, h2, h3 { margin: 0; }
  body { isolation: isolate; }
  button { font: inherit; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 5px; }

  h1, h2, h3 { font-family: var(--font-sans); font-weight: var(--weight-semibold); text-wrap: balance; }
  h1 { font-size: var(--text-3xl); line-height: .98; letter-spacing: -.04em; }
  h2 { font-size: var(--text-2xl); line-height: 1.1; letter-spacing: -.025em; }
  h3 { font-size: var(--text-xl); line-height: 1.2; letter-spacing: -.02em; }

  /* A page's intro paragraph, right under its h1. */
  .page-content > h1 + p {
    max-width: 65ch;
    margin-block-start: var(--space-s);
    color: var(--muted-ink);
    font-size: var(--text-l);
  }

  /* A secondary call to action next to a .pill. */
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    min-block-size: var(--tap-target);
    font-size: var(--text-s);
    font-weight: var(--weight-semibold);
    text-underline-offset: .23em;
    text-decoration-color: var(--muted-ink);
  }

  .label {
    font: var(--weight-semibold) var(--text-xs)/1.4 var(--font-mono);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .page { max-width: var(--page-max); margin-inline: auto; padding-inline: var(--page-gutter); }
  .page-content { padding-block: var(--page-block); }
  .card { padding: var(--card-pad); border-radius: var(--card-radius); }
  header {
    container: site-header / inline-size;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: var(--header-height);
    gap: var(--space-3xs) var(--space-s);
    padding-block: var(--space-2xs);
    border-bottom: 1px solid var(--line);
  }
  header a { text-decoration: none; font-weight: var(--weight-semibold); font-size: var(--text-s); }
  header a:hover { text-decoration: underline; }
  header nav { inline-size: 100%; }
  header nav:has(.menu-toggle:not([hidden])) { inline-size: auto; }
  .menu-toggle { --compact-menu: 1; }
  .menu-toggle:has(+ .menu-links:popover-open) svg { rotate: 180deg; }
  .menu-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs) clamp(var(--space-xs), 3vw, var(--space-l));
  }
  .menu-links[popover]:not(:popover-open) { display: none; }
  .menu-links:popover-open {
    position: absolute;
    inset: auto;
    top: calc(var(--menu-top) + var(--space-2xs));
    left: var(--menu-right-edge);
    translate: -100% 0;
    inline-size: min(15rem, calc(100dvi - 2.5rem));
    max-block-size: calc(100dvh - 4.5rem);
    overflow: auto;
    margin: 0;
    padding: var(--space-2xs);
    border-radius: var(--card-radius);
    color: var(--ink);
    gap: 0;
  }
  .menu-links:popover-open :is(a, .motion-toggle:not([hidden])) {
    display: flex;
    align-items: center;
    inline-size: 100%;
    min-block-size: var(--tap-target);
    padding-inline: var(--space-xs);
  }
  header nav a { white-space: nowrap; }
  header [aria-current="page"] { text-decoration: underline; text-underline-offset: .3em; }
  .github, .motion-toggle:not([hidden]) { display: inline-flex; gap: var(--space-2xs); align-items: center; }
  :is(.github, .motion-toggle) svg { flex: none; }
  .motion-toggle {
    align-self: stretch;
    padding: 0;
    padding-block-start: var(--space-2xs);
    border: 0;
    border-block-start: 1px solid var(--line);
    background: oklch(none none none / 0);
    color: inherit;
    font-size: var(--text-s);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    cursor: pointer;
  }
  .motion-toggle:hover span { text-decoration: underline; }
  .motion-toggle:not([data-paused="true"]) .motion-play,
  .motion-toggle[data-paused="true"] .motion-pause { display: none; }

  @container site-header (min-width: 31rem) {
    .menu-toggle:not(:has(+ .menu-links .motion-toggle)) { --compact-menu: 0; }
    header nav:not(:has(.menu-toggle:not([hidden]))) { flex: 1 1 auto; inline-size: auto; }
    .menu-links:not([popover], :has(.motion-toggle)) { flex-flow: row wrap; align-items: center; justify-content: flex-end; }
  }
  @container site-header (min-width: 41rem) {
    .menu-toggle { --compact-menu: 0; }
    .menu-links:not([popover]) { flex-flow: row wrap; align-items: center; justify-content: flex-end; }
    .menu-links:not([popover]) .motion-toggle {
      padding-block-start: 0;
      padding-inline-start: var(--space-xs);
      border-block-start: 0;
      border-inline-start: 1px solid var(--line);
    }
  }
  /* With both the header lamp and the motion toggle, the full menu needs about 46rem for one row. */
  @container site-header (max-width: 47rem) {
    header:has(.menu-lamp) .menu-toggle:has(+ .menu-links .motion-toggle) { --compact-menu: 1; }
  }
  .brand { display: flex; gap: var(--space-3xs); align-items: center; }
  .menu-lamp {
    --lamp-globe-unit: .25rem;
    display: grid;
    place-items: center;
    padding: 0 .65rem;
    width: var(--tap-target);
    height: var(--tap-target);
    border: 0;
    border-radius: 50%;
    background: oklch(none none none / 0);
    -webkit-tap-highlight-color: oklch(none none none / 0);
  }
  .menu-lamp:enabled { cursor: pointer; }

  .glass-panel, .glass-control, .pill {
    border: 1px solid var(--glass-edge);
    background-image: var(--glass-tint, none), linear-gradient(155deg in oklch, var(--glass-glint), oklch(none none none / 0) 58%);
    box-shadow: inset 0 1px 0 var(--glass-glint), var(--glass-shadow);
  }

  .glass-panel {
    background-color: var(--glass-panel);
    backdrop-filter: blur(18px) saturate(1.15);
  }

  .glass-rainbow {
    --glass-tint: var(--instruction-glow,
      radial-gradient(ellipse 15rem 6rem at left top in oklch, oklch(89.9% 0.097 77), oklch(83.5% 0.128 339 / 0.537) 44%, oklch(none none none / 0) 100%),
      radial-gradient(ellipse 24rem 8rem at 10% top in oklch, oklch(79.9% 0.123 295 / 0.702), oklch(86.9% 0.073 249 / 0.51) 48%, oklch(none none none / 0) 100%),
      radial-gradient(ellipse 26rem 7rem at 15% top in oklch, oklch(88.4% 0.109 166 / 0.729), oklch(none none none / 0) 100%)
    );
  }

  .glass-control, .pill {
    --glass-glint: var(--glass-control-glint);
    background-color: var(--glass-control);
    backdrop-filter: blur(12px) saturate(1.25);
  }

  :is(.glass-control, .pill):hover:not(:disabled) { background-color: var(--glass-control-hover); }

  /* Shared by pill-shaped buttons and links. */
  .pill {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-block-size: var(--tap-target);
    padding-inline: var(--space-s);
    border-radius: var(--pill-radius);
    color: var(--ink);
    font-size: var(--text-s);
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .pill[hidden] { display: none; }
  .pill svg { flex: none; }

  :root[data-lamp="off"] {
    color-scheme: dark;
    background-color: var(--sky);
    --moonlight: 1;
    --sky: oklch(18.22% 0.0339 260.1);
    --paper: oklch(25.07% 0.0468 257.9);
    --ink: oklch(96.51% 0.0165 259.4);
    --muted-ink: oklch(83.58% 0.0378 254.6);
    --line: oklch(57.99% 0.0602 256.2);
    --focus: oklch(86.73% 0.0671 252);
    --glass-panel: oklch(26.43% 0.0441 253.4 / 0.91);
    --glass-glint: oklch(88.29% 0.0606 247 / 0.161);
    --instruction-glow: none;
    --glass-control: oklch(45.44% 0.0752 251 / 0.314);
    --glass-control-hover: oklch(51.95% 0.0801 253.6 / 0.502);
    --glass-control-glint: oklch(88.29% 0.0606 247 / 0.11);
    --glass-edge: oklch(80.43% 0.0771 251.7 / 0.467);
    --backdrop: oklch(14% 0.03 258 / 0.96);
    --glass-shadow: 0 14px 38px -20px oklch(0% 0 0 / 0.8), 0 3px 12px oklch(14.45% 0.024 260.2 / 0.341);
  }

  @media (min-width: 48rem) {
    :root { --header-height: 5rem; }
  }
</style>
