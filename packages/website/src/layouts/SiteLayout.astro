---
import AmbientBackground from '../components/AmbientBackground.astro';
import LampGlobe from '../components/LampGlobe.astro';

interface Props {
  ambientLighting?: boolean;
  title: string;
  description: string;
}

const { ambientLighting, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isHome = currentPath === base;
const mainLinks = [
  { path: base + '/how-it-works', label: 'See how it works' },
  { path: base + '/install', label: 'Install now' },
];
const repository = 'https://github.com/bjesuiter/tuna-hue';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      if (new URLSearchParams(location.search).get('lamp') === 'off') {
        document.documentElement.dataset.lamp = 'off';
      }
    </script>
  </head>
  <body>
    <div class="page">
      <header>
        <div class="brand">
          {!isHome && (
            <button class="menu-lamp" type="button" aria-label="Living Room lights" aria-pressed="true" data-menu-lamp disabled>
              <LampGlobe />
            </button>
          )}
          <a href={base + '/'} data-lamp-link>Tuna Hue Control</a>
        </div>
        <nav aria-label="Main">
          {mainLinks.map(({ path, label }) => (
            <a href={path + '/'} aria-current={currentPath === path ? 'page' : undefined} data-lamp-link>{label}</a>
          ))}
          <a class="github" href={repository}>
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
            </svg>
            GitHub
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M3 9 9 3M4 3h5v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </nav>
      </header>
      {ambientLighting && <AmbientBackground />}

      <main>
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>

<script>
  import { setLamp, syncLampLinks } from '../components/lamp-state';

  syncLampLinks();

  const menuLamp = document.querySelector<HTMLButtonElement>('[data-menu-lamp]');
  if (menuLamp) {
    menuLamp.setAttribute('aria-pressed', String(document.documentElement.dataset.lamp !== 'off'));
    menuLamp.disabled = false;
    menuLamp.addEventListener('click', () => {
      const lit = document.documentElement.dataset.lamp === 'off';
      setLamp(lit);
      menuLamp.setAttribute('aria-pressed', String(lit));
    });
  }
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }

    :root { scroll-behavior: smooth; }

    ::view-transition-group(root) { animation-duration: 260ms; }

    .lamp-transition { view-transition-name: hue-lamp; }
    ::view-transition-group(hue-lamp) {
      animation-duration: 420ms;
      animation-timing-function: cubic-bezier(.22, 1, .36, 1);
    }
  }

  :root {
    color-scheme: light;
    --paper: oklch(100% 0 0);
    --ink: oklch(19.91% 0.01 294.6);
    --muted-ink: oklch(46.15% 0.0243 294.6);
    --line: oklch(89.84% 0.011 297.6);
    --focus: oklch(51.29% 0.2049 287.3);
    --glass-panel: oklch(99.31% 0.0034 247.9 / 0.875);
    --glass-control: oklch(96.78% 0.0153 257.2 / 0.251);
    --glass-control-hover: oklch(96.78% 0.0153 257.2 / 0.439);
    --glass-control-glint: oklch(100% 0 0 / 0.329);
    --glass-edge: oklch(61.83% 0.0531 258 / 0.329);
    --glass-glint: oklch(100% 0 0 / 0.733);
    --glass-shadow: 0 16px 38px -26px oklch(48.11% 0.0813 263.7 / 0.451), 0 3px 12px oklch(60.94% 0.0706 263.4 / 0.141);
    --heading-font: 'Avenir Next', system-ui, sans-serif;
    background: var(--paper);
    color: var(--ink);
    font: 1rem/1.5 'Avenir Next', system-ui, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; }
  body, p, h1 { margin: 0; }
  body { isolation: isolate; }
  button { font: inherit; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 5px; }

  .page { max-width: 90rem; margin-inline: auto; padding-inline: clamp(1.25rem, 5vw, 5rem); }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    min-height: 5rem;
    gap: .35rem 1rem;
    padding-block: .55rem;
    border-bottom: 1px solid var(--line);
  }
  header a { text-decoration: none; font-weight: 650; font-size: .875rem; }
  header a:hover { text-decoration: underline; }
  header nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; flex: 1 1 auto; gap: .35rem clamp(.75rem, 3vw, 1.75rem); }
  header [aria-current="page"] { text-decoration: underline; text-underline-offset: .3em; }
  .github { display: inline-flex; gap: .45rem; align-items: center; }
  .brand { display: flex; gap: .35rem; align-items: center; }
  .menu-lamp {
    --lamp-globe-unit: .25rem;
    display: grid;
    place-items: center;
    padding: 0 .65rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    -webkit-tap-highlight-color: transparent;
  }
  .menu-lamp:enabled { cursor: pointer; }

  .glass-panel, .glass-control {
    border: 1px solid var(--glass-edge);
    background-image: var(--glass-tint, none), linear-gradient(155deg in oklch, var(--glass-glint), oklch(none none none / 0) 58%);
    box-shadow: inset 0 1px 0 var(--glass-glint), var(--glass-shadow);
  }

  .glass-panel {
    background-color: var(--glass-panel);
    backdrop-filter: blur(18px) saturate(1.15);
  }

  .glass-rainbow {
    --glass-tint: var(--instruction-glow,
      radial-gradient(ellipse 15rem 6rem at left top in oklch, oklch(89.9% 0.097 77), oklch(83.5% 0.128 339 / 0.537) 44%, oklch(none none none / 0) 100%),
      radial-gradient(ellipse 24rem 8rem at 10% top in oklch, oklch(79.9% 0.123 295 / 0.702), oklch(86.9% 0.073 249 / 0.51) 48%, oklch(none none none / 0) 100%),
      radial-gradient(ellipse 26rem 7rem at 15% top in oklch, oklch(88.4% 0.109 166 / 0.729), oklch(none none none / 0) 100%)
    );
  }

  .glass-control {
    --glass-glint: var(--glass-control-glint);
    background-color: var(--glass-control);
    backdrop-filter: blur(12px) saturate(1.25);
  }

  .glass-control:hover:not(:disabled) { background-color: var(--glass-control-hover); }

  .primary-link {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: .7rem .95rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: .025em;
  }

  :root[data-lamp="off"] {
    color-scheme: dark;
    background-color: var(--sky);
    --moonlight: 1;
    --sky: oklch(18.22% 0.0339 260.1);
    --paper: oklch(25.07% 0.0468 257.9);
    --ink: oklch(96.51% 0.0165 259.4);
    --muted-ink: oklch(83.58% 0.0378 254.6);
    --line: oklch(57.99% 0.0602 256.2);
    --focus: oklch(86.73% 0.0671 252);
    --glass-panel: oklch(26.43% 0.0441 253.4 / 0.91);
    --glass-control: oklch(45.44% 0.0752 251 / 0.314);
    --glass-control-hover: oklch(51.95% 0.0801 253.6 / 0.502);
    --glass-control-glint: oklch(88.29% 0.0606 247 / 0.11);
    --glass-edge: oklch(80.43% 0.0771 251.7 / 0.467);
    --glass-glint: oklch(88.29% 0.0606 247 / 0.161);
    --instruction-glow: none;
    --glass-shadow: 0 14px 38px -20px oklch(0% 0 0 / 0.8), 0 3px 12px oklch(14.45% 0.024 260.2 / 0.341);
  }

  @media (max-width: 48rem) {
    header { min-height: 3.8rem; }
  }
</style>
