---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout
  ambientLighting
  noindex
  title="Page not found · Tuna Hue Control"
  description="This page doesn’t exist. Head back to Tuna Hue Control."
>
  <section class="not-found page-content" aria-labelledby="not-found-title">
    <p class="label">404 · Page not found</p>
    <h1 id="not-found-title">No light in this room.</h1>
    <p class="intro">The page you’re looking for doesn’t exist or has moved.</p>
    <div class="actions">
      <a class="pill" href={base + '/'} data-lamp-link>Back to home</a>
      <a class="text-link" href={base + '/install/'} data-lamp-link>Install now <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .not-found {
    display: grid;
    align-content: center;
    justify-items: start;
    min-block-size: calc(100dvh - var(--header-height));
  }
  h1 { max-width: 12ch; margin-block-start: var(--space-s); }
  /* Colour, size and spacing come from the layout's intro-paragraph style. */
  .intro { max-width: 32ch; }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    margin-block-start: var(--space-l);
  }
</style>
