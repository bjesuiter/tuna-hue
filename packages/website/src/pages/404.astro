---
import LampGlobe from '../components/LampGlobe.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout
  ambientLighting
  noindex
  title="Page not found · Tuna Hue Control"
  description="This page doesn’t exist. Head back to Tuna Hue Control."
>
  <section class="not-found page-content" aria-labelledby="not-found-title">
    <div class="bulb">
      <LampGlobe viewTransition={false}><span class="mark">?</span></LampGlobe>
    </div>
    <p class="label">404 · Page not found</p>
    <h1 id="not-found-title">No light in this room.</h1>
    <p class="intro">The page you’re looking for doesn’t exist or has moved.</p>
    <div class="actions">
      <a class="pill" href={base + '/'} data-lamp-link>Back to home</a>
      <a class="text-link" href={base + '/install/'} data-lamp-link>Install now <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .not-found {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: start;
    min-block-size: calc(100dvh - var(--header-height));
  }
  /* Grid, so the globe's <span> takes the wrapper's width. */
  .bulb {
    display: grid;
    container-type: inline-size;
    inline-size: clamp(7rem, 30vw, 9rem);
    margin-block-end: var(--space-l);
  }
  .mark {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    color: oklch(72% 0.06 350);
    font-size: 56cqi;
    font-weight: var(--weight-semibold);
    line-height: 1;
    text-shadow: 0 1px 0 oklch(100% 0 0 / 0.7);
  }
  :global([data-lamp="off"]) .mark {
    color: oklch(82% 0.06 252 / 0.85);
    text-shadow: 0 0 .25em oklch(70% 0.09 252 / 0.6);
  }
  @media (min-width: 48rem) {
    .not-found {
      /* The home hero's columns, so the bulb sits where the home globe does. */
      grid-template-columns: minmax(19rem, .82fr) minmax(0, 1.18fr);
      column-gap: clamp(var(--space-m), 4vw, var(--space-2xl));
    }
    .not-found > :not(.bulb) { grid-column: 1; }
    .bulb {
      grid-column: 2;
      grid-row: 1 / 5;
      align-self: center;
      justify-self: center;
      inline-size: clamp(11rem, 20vw, 17rem);
      margin: 0;
    }
  }
  h1 { max-width: 12ch; margin-block-start: var(--space-s); }
  /* Colour, size and spacing come from the layout's intro-paragraph style. */
  .intro { max-width: 32ch; }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    margin-block-start: var(--space-l);
  }
</style>
