---
import { Content as PrivacyNotice } from '../../../plugin/PRIVACY.md';
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
  title="Tuna Hue Control privacy"
  description="How Tuna Hue Control discovers Philips Hue Bridges, uses local network access, and stores application keys."
>
  <article class="privacy page-content">
    <PrivacyNotice />
  </article>
</SiteLayout>

<style>
  .privacy { max-inline-size: 70ch; }
  /* Margins, not a grid gap, so the intro paragraph's own spacing under the h1 applies. */
  .privacy > :global(* + *) { margin-block-start: var(--space-s); }

  .privacy :global(ul) {
    display: grid;
    gap: var(--space-xs);
    margin-block-end: 0;
    padding-inline-start: var(--space-s);
  }
  .privacy :global(code) {
    font-family: var(--font-mono);
    font-size: .9em;
    overflow-wrap: anywhere;
  }
</style>
