---
import SiteLayout from '../layouts/SiteLayout.astro';
import LightDemo from './LightDemo.astro';
import Walkthrough from './Walkthrough.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout
  ambientLighting
  title="Tuna Hue Control — Lights at your fingertips"
  description="Turn Philips Hue rooms and zones on or off from the Tuna launcher for macOS."
>
  <section class="hero" aria-labelledby="headline">
    <div class="intro">
      <p class="eyebrow">A Tuna extension for Philips Hue</p>
      <h1 id="headline">Lights at your fingertips.</h1>
      <p class="summary">Find a room or zone in Tuna and turn its lights on or off, right from your Mac.</p>
      <a class="install" href={base + '/install/'}>Get started <span aria-hidden="true">→</span></a>
      <a class="walkthrough-link" href="#walkthrough">See how it works <span aria-hidden="true">↓</span></a>
    </div>
    <LightDemo />
  </section>
  <section class="compatibility" aria-label="Requirements">
    <p>macOS 15+</p>
    <p>Tuna 0.113+</p>
    <p>Philips Hue Bridge</p>
  </section>
  <Walkthrough />
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    padding-block: clamp(3rem, 7vw, 7rem);
  }
  .eyebrow, .compatibility { font: 600 .72rem/1.5 ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .intro { container-type: inline-size; }
  .hero h1 {
    max-width: 12ch;
    margin-block: .9rem 1.2rem;
    font: 650 clamp(2.6rem, 17cqi, 7rem)/.98 var(--heading-font);
    letter-spacing: -.06em;
    text-wrap: balance;
  }
  .summary { max-width: 29ch; color: var(--muted-ink); font-size: clamp(1.05rem, 1.5vw, 1.25rem); }
  .install {
    display: inline-flex;
    gap: 1.1rem;
    margin-top: 1.65rem;
    background: var(--accent);
    border: 1px solid var(--line);
    box-shadow: var(--soft-shadow);
    padding: .7rem .95rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 750;
  }
  .install:hover { background: white; }
  .walkthrough-link { display: inline-block; margin: 1rem 0 0 .95rem; font-size: .9rem; font-weight: 650; text-underline-offset: .2em; }
  .compatibility { display: flex; align-items: center; border-block: 1px solid var(--line); gap: .7rem 2rem; flex-wrap: wrap; padding-block: 1rem; margin-bottom: 2rem; }
  @media (max-width: 48rem) {
    .hero { grid-template-columns: 1fr; gap: 1.8rem; }
    .hero h1 { font-size: clamp(2.8rem, 10vw, 5.5rem); }
  }
</style>
