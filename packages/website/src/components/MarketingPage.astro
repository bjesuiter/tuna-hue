---
import SiteLayout from '../layouts/SiteLayout.astro';
import BuildInfo from './BuildInfo.astro';
import LightDemo from './LightDemo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout
  ambientLighting
  title="Tuna Hue Control — Lights at your fingertips"
  description="Turn Philips Hue rooms and zones on or off from the Tuna launcher for macOS."
>
  <section class="hero page-content" aria-labelledby="headline">
    <div class="intro">
      <div class="hero-copy">
        <p class="label">A Tuna extension for Philips Hue</p>
        <h1 id="headline">Lights at your fingertips.</h1>
        <p class="summary">Find a room or zone in Tuna and turn its lights on or off, right from your Mac.</p>
      </div>
      <div class="hero-actions">
        <a class="pill" href={base + '/install/'} data-lamp-link>Install now</a>
        <a class="text-link" href={base + '/how-it-works/'} data-lamp-link>See how it works <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <LightDemo />
  </section>
  <footer slot="footer" class="requirements">
    <div class="requirements-bar glass-panel">
      <div class="requirements-links label">
        <a href="https://support.apple.com/en-us/120282" target="_blank" rel="noopener">macOS 15+</a>
        <a href="https://tunaformac.com/" target="_blank" rel="noopener">Tuna 0.113+</a>
        <a href="https://www.philips-hue.com/en-us/p/hue-bridge/046677458478/specifications" target="_blank" rel="noopener">Philips Hue Bridge</a>
      </div>
      <BuildInfo />
    </div>
  </footer>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--space-l);
  }
  .hero-copy { container-type: inline-size; }
  .hero h1 {
    max-width: 12ch;
    margin-block: var(--space-s);
  }
  .summary { max-width: 29ch; color: var(--muted-ink); font-size: var(--text-l); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs) var(--space-s); margin-block-start: var(--space-m); }
  .hero, .requirements { --requirements-height: calc(5.5rem + env(safe-area-inset-bottom, 0px)); }
  .requirements-bar {
    border-radius: var(--card-radius);
    background-color: color-mix(in oklch, var(--paper) 52%, oklch(none none none / 0));
    background-image: none;
  }
  /* Centred under the centred demo while the footer is an inline card. */
  .requirements-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-s) calc(var(--space-s) + env(safe-area-inset-bottom, 0px));
    padding-inline: var(--space-s);
  }
  .requirements-links a { text-underline-offset: .25em; }
  /* While the bar is an inline card, keep it off the bottom of the page. */
  .requirements { padding-block-end: calc(var(--page-gutter) + env(safe-area-inset-bottom, 0px)); }

  @media (min-width: 48rem) {
    /* 19rem keeps the install pill and walkthrough link on one row. */
    .hero { grid-template-columns: minmax(19rem, .82fr) minmax(0, 1.18fr); gap: clamp(var(--space-m), 4vw, var(--space-2xl)); }
    /* The home hero is the one display-size heading; it scales with its column. */
    .hero h1 { font-size: clamp(var(--text-3xl), 17cqi, 7rem); }
  }

  @supports (grid-template-rows: subgrid) {
    @media (min-width: 48rem) {
      .hero { row-gap: var(--space-2xs); }
      .intro, .hero > :global(.demo) {
        grid-row: span 3;
        display: grid;
        grid-template-rows: subgrid;
        align-self: stretch;
      }
      .hero-copy { align-self: center; }
      .hero-actions {
        grid-row: 3;
        align-self: center;
        margin-block-start: 0;
      }
    }
  }

  @media (min-width: 48rem) and (min-height: 30rem) {
    /* The hero fills the window between the header and the fixed requirements bar. */
    .hero {
      --hero-height: calc(100dvh - var(--header-height) - var(--requirements-height));
      min-block-size: var(--hero-height);
      padding-block: var(--space-l);
      align-content: center;
    }
    /* Shorter windows trim the stage; 7rem leaves room for the demo caption and console. */
    .hero :global(.stage) { max-block-size: calc(var(--hero-height) - 2 * var(--space-l) - 7rem); }
    .requirements { min-block-size: var(--requirements-height); padding-block-end: 0; }
    .requirements-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 2;
      border-inline: 0;
      border-block-end: 0;
      border-radius: 0;
      padding-block-end: env(safe-area-inset-bottom, 0px);
    }
    .requirements-links {
      justify-content: flex-start;
      max-inline-size: var(--page-max);
      margin-inline: auto;
      padding: var(--space-xs) var(--page-gutter) 0;
      min-block-size: 2.5rem;
    }
  }
</style>
