---
import SiteLayout from '../layouts/SiteLayout.astro';
import LightDemo from './LightDemo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout
  ambientLighting
  title="Tuna Hue Control — Lights at your fingertips"
  description="Turn Philips Hue rooms and zones on or off from the Tuna launcher for macOS."
>
  <section class="hero" aria-labelledby="headline">
    <div class="intro">
      <div class="hero-copy">
        <p class="eyebrow">A Tuna extension for Philips Hue</p>
        <h1 id="headline">Lights at your fingertips.</h1>
        <p class="summary">Find a room or zone in Tuna and turn its lights on or off, right from your Mac.</p>
      </div>
      <div class="hero-actions">
        <a class="primary-link glass-control" href={base + '/install/'} data-lamp-link>Install Tuna Hue</a>
        <a class="walkthrough-link" href={base + '/how-it-works/'} data-lamp-link>See how it works <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <LightDemo />
  </section>
  <footer slot="footer" class="requirements" aria-label="Requirements">
    <div class="requirements-bar glass-panel">
      <div class="requirements-links">
        <a href="https://support.apple.com/en-us/120282" target="_blank" rel="noopener">macOS 15+</a>
        <a href="https://tunaformac.com/" target="_blank" rel="noopener">Tuna 0.113+</a>
        <a href="https://www.philips-hue.com/en-us/p/hue-bridge/046677458478/specifications" target="_blank" rel="noopener">Philips Hue Bridge</a>
      </div>
    </div>
  </footer>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 1.8rem;
    padding-block: clamp(3rem, 7vw, 7rem);
  }
  .eyebrow, .requirements-links { font: 600 .72rem/1.5 ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .hero-copy { container-type: inline-size; }
  .hero h1 {
    max-width: 12ch;
    margin-block: .9rem 1.2rem;
    font: 650 clamp(2.8rem, 10vw, 5.5rem)/.98 var(--heading-font);
    letter-spacing: -.06em;
    text-wrap: balance;
  }
  .summary { max-width: 29ch; color: var(--muted-ink); font-size: clamp(1.05rem, 1.5vw, 1.25rem); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-block-start: 1.65rem; }
  .walkthrough-link {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-block-size: 2.75rem;
    font-size: .9rem;
    font-weight: 600;
    text-underline-offset: .23em;
    text-decoration-color: var(--muted-ink);
  }
  .requirements { --requirements-height: calc(4rem + env(safe-area-inset-bottom, 0px)); }
  .requirements-bar {
    border-radius: 1rem;
    background-color: color-mix(in oklch, var(--paper) 52%, oklch(none none none / 0));
    background-image: none;
  }
  .requirements-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .7rem 2rem;
    padding-block: 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
    padding-inline: 1rem;
  }
  .requirements-links a { text-underline-offset: .25em; }

  @media (min-width: 48rem) {
    .hero { grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(1.5rem, 4vw, 4.5rem); }
    .hero h1 { font-size: clamp(2.6rem, 17cqi, 7rem); }
  }

  @supports (grid-template-rows: subgrid) {
    @media (min-width: 48rem) {
      .hero { row-gap: .5rem; }
      .intro, .hero > :global(.demo) {
        grid-row: span 3;
        display: grid;
        grid-template-rows: subgrid;
        align-self: stretch;
      }
      .hero-copy { align-self: center; }
      .hero-actions {
        grid-row: 3;
        align-self: center;
        margin-block-start: 0;
      }
    }
  }

  @media (min-width: 48rem) and (min-height: 30rem) {
    .requirements { min-block-size: var(--requirements-height); }
    .requirements-bar {
      position: fixed;
      inset: auto 0 0;
      z-index: 2;
      border-inline: 0;
      border-block-end: 0;
      border-radius: 0;
    }
    .requirements-links {
      max-inline-size: 90rem;
      min-block-size: var(--requirements-height);
      margin-inline: auto;
      padding-inline: clamp(1.25rem, 5vw, 5rem);
    }
  }
</style>
