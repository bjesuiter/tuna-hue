---
import { Code } from 'astro:components';
import type { ShikiTransformer, ThemeRegistration } from 'shiki';

// HAST node types, taken from Shiki so the page needs no direct `hast` dependency.
type HastRoot = Parameters<NonNullable<ShikiTransformer['root']>>[0];
type ElementContent = Extract<HastRoot['children'][number], { type: 'element' }>['children'][number];

// Token colours come from the --code-* custom properties below, so the lamp switch recolours them.
const codeTheme: ThemeRegistration = {
  name: 'tuna-hue',
  colors: { 'editor.foreground': 'inherit', 'editor.background': 'transparent' },
  tokenColors: [
    { scope: ['keyword.control', 'storage'], settings: { foreground: 'var(--code-keyword)' } },
    { scope: ['string.quoted'], settings: { foreground: 'var(--code-string)' } },
    { scope: ['constant.other.option', 'constant.numeric', 'variable.other.assignment'], settings: { foreground: 'var(--code-variable)' } },
    { scope: ['comment'], settings: { foreground: 'var(--code-comment)' } },
  ],
};

// Break opportunities after each "/", so long paths wrap there in the wrapping agent prompt.
const breakAfterSlashes = (nodes: ElementContent[]): ElementContent[] => nodes.flatMap((node): ElementContent[] => {
  if (node.type === 'element') return [{ ...node, children: breakAfterSlashes(node.children) }];
  if (node.type !== 'text' || !node.value.includes('/')) return [node];
  return node.value.split(/(?<=\/)/).flatMap((part, index): ElementContent[] => [
    ...(index > 0 ? [{ type: 'element' as const, tagName: 'wbr', properties: {}, children: [] }] : []),
    { type: 'text', value: part },
  ]);
});

// Emit only <code class="language-bash"> with token spans, so each snippet sits in the page's own <pre>.
const bareCode: ShikiTransformer = {
  root(root) {
    const pre = root.children.find((node) => node.type === 'element');
    const code = pre?.type === 'element' ? pre.children.find((node) => node.type === 'element') : undefined;
    if (code?.type !== 'element') return;
    root.children = [{ type: 'element', tagName: 'code', properties: { class: 'language-bash' }, children: code.children }];
  },
  span(node) {
    if (node.properties.style === 'color:inherit') delete node.properties.style;
  },
};

// Only for the prompt: browsers honour <wbr> even inside the manual steps' unwrapped <pre>.
const slashBreaks: ShikiTransformer = {
  root(root) {
    root.children = breakAfterSlashes(root.children as ElementContent[]);
  },
};

const fetchSource = `git clone "https://github.com/bjesuiter/tuna-hue.git"
cd tuna-hue`;

const buildExtension = `xcodebuild \\
  -project packages/plugin/TunaHue.xcodeproj \\
  -scheme TunaHue \\
  -configuration Release \\
  -destination 'generic/platform=macOS' \\
  -derivedDataPath packages/plugin/build \\
  build`;

const installExtension = `extensionsDir="$HOME/Library/Application Support/Tuna/ExtensionsDev"
mkdir -p "$extensionsDir"
ditto \\
  packages/plugin/build/Build/Products/Release/TunaHue.framework \\
  "$extensionsDir/TunaHue.framework"`;

const agentInstructions = 'Build and install Tuna Hue Control on this Mac. Check for macOS 15+, Tuna 0.113+, and Xcode 16+ first. Run the following commands in order. Copy the framework only after the build succeeds.';
const agentFollowUp = 'Tell me when the framework is installed and show me any errors you encounter. I’ll restart Tuna, make the trust decision if prompted, and pair my Hue Bridge with Connect First Hue Bridge.';
---

<article class="guide page-content" aria-labelledby="install-title">
  <h1 id="install-title">Install Tuna Hue Control</h1>
  <p>Get it from Tuna’s extension store once it’s listed, or build it from source today, with your coding agent or by hand.</p>

  <section class="install-card card glass-panel glass-rainbow" aria-labelledby="store-title">
    <h2 id="store-title">Install from the extension store</h2>
    <p class="availability">Tuna Hue Control might come to the store soon.</p>
    <p>Extension developers and Tuna’s maintainer work together to review each extension by hand before it appears in the store.</p>
    <p>In the meantime, you can <a href="#agent-build">ask your agent to build it</a> or <a href="#build-from-source">build it manually</a>.</p>
  </section>

  <section class="agent install-card card glass-panel glass-rainbow" aria-labelledby="agent-build">
    <h2 id="agent-build">Let your agent build from source</h2>
    <p>
      Copy this prompt into a coding agent with Terminal access on the Mac where you use Tuna.
      <span id="copy-prompt-status" role="status"></span>
    </p>
    <button type="button" class="copy-prompt pill" command="--copy" commandfor="agent-prompt" hidden>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
        <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.25" />
        <path d="M3.5 10.75A1.25 1.25 0 0 1 2.25 9.5v-6A1.25 1.25 0 0 1 3.5 2.25h6a1.25 1.25 0 0 1 1.25 1.25" />
      </svg>
      Copy prompt
    </button>
    <pre id="agent-prompt" class="agent-prompt" tabindex="0" role="region" aria-label="Prompt for your coding agent">{agentInstructions}{'\n\n'}<Code code={fetchSource} lang="bash" theme={codeTheme} transformers={[bareCode, slashBreaks]} />{'\n\n'}<Code code={buildExtension} lang="bash" theme={codeTheme} transformers={[bareCode, slashBreaks]} />{'\n\n'}<Code code={installExtension} lang="bash" theme={codeTheme} transformers={[bareCode, slashBreaks]} />{'\n\n'}{agentFollowUp}</pre>
  </section>

  <section class="source install-card card glass-panel glass-rainbow" aria-labelledby="build-from-source">
    <h2 id="build-from-source">Build from source (manually)</h2>

    <div class="requirements">
      <h3>Before you start</h3>
      <ul>
        <li>macOS 15 or later</li>
        <li>Tuna 0.113 or later</li>
        <li>Xcode 16 or later, opened once to finish setup</li>
        <li>A Philips Hue Bridge on the same network as your Mac</li>
      </ul>
    </div>

    <ol class="steps" role="list">
      <li>
        <span class="number label" aria-hidden="true">01</span>
        <h3>Get the source</h3>
        <p>Open Terminal and run these commands to download the source and enter its folder.</p>
        <pre tabindex="0" role="region" aria-label="Download the source"><Code code={fetchSource} lang="bash" theme={codeTheme} transformers={[bareCode]} /></pre>
      </li>
      <li>
        <span class="number label" aria-hidden="true">02</span>
        <h3>Build the extension</h3>
        <p>Run this in the same Terminal window. Xcode downloads the pinned TunaKit dependency on the first build.</p>
        <pre tabindex="0" role="region" aria-label="Build the extension with Xcode"><Code code={buildExtension} lang="bash" theme={codeTheme} transformers={[bareCode]} /></pre>
        <p>If Terminal reports that the active developer directory points to Command Line Tools, select your full Xcode installation under <strong>Xcode → Settings → Locations → Command Line Tools</strong> and rerun the build.</p>
      </li>
      <li>
        <span class="number label" aria-hidden="true">03</span>
        <h3>Copy the extension to Tuna</h3>
        <p>After the build succeeds, create Tuna’s developer extensions folder and copy the framework into it.</p>
        <pre tabindex="0" role="region" aria-label="Copy the framework into Tuna’s developer extensions folder"><Code code={installExtension} lang="bash" theme={codeTheme} transformers={[bareCode]} /></pre>
      </li>
      <li>
        <span class="number label" aria-hidden="true">04</span>
        <h3>Restart Tuna and connect your bridge</h3>
        <p>Quit and reopen Tuna so it loads the framework. If Tuna asks you to trust the extension, confirm only if you trust the source you built. Open <strong>Settings → Sources</strong> and check that <strong>Hue Groups</strong> appears.</p>
        <p>Search for <strong>Hue</strong> and run <strong>Connect First Hue Bridge</strong>. If the command is missing, set <strong>Hue Groups → In global search</strong> to <strong>All</strong>.</p>
        <p>Allow local network access if macOS asks. Select your bridge, choose <strong>Continue</strong>, and press the physical link button when prompted. Once Tuna confirms the connection, search for a room or zone to control its lights.</p>
      </li>
    </ol>
  </section>
</article>

<style>
  .guide {
    --code-keyword: light-dark(oklch(40% .14 302), oklch(84% .09 302));
    --code-string: light-dark(oklch(38% .09 158), oklch(85% .10 158));
    --code-variable: light-dark(oklch(41% .13 249), oklch(84% .10 249));
    --code-comment: var(--muted-ink);
    max-inline-size: 56rem;
  }
  .guide h1 { max-inline-size: 15ch; }
  .guide > p + .install-card { margin-block-start: var(--section-gap); }
  .install-card + .install-card { margin-block-start: var(--space-l); }
  p { color: var(--muted-ink); }
  .install-card p { margin-block-start: var(--space-xs); }
  .availability { color: var(--ink); font-weight: var(--weight-semibold); }
  .agent { scroll-margin-block-start: var(--space-m); }
  .source h2 { scroll-margin-block-start: var(--space-m); }
  .requirements { margin-block-start: var(--space-m); }
  .requirements ul { margin-block: var(--space-xs) 0; padding-inline-start: var(--space-m); color: var(--muted-ink); }
  .steps {
    margin-block: var(--space-m) 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--line);
  }
  .steps li:last-child { padding-block-end: 0; }
  .number { display: block; margin-block-end: var(--space-xs); color: var(--muted-ink); }
  .steps p { margin-block-start: var(--space-xs); }
  pre {
    max-inline-size: 100%;
    margin-block: var(--space-xs) 0;
    overflow: auto;
    font: var(--text-s)/1.65 var(--font-mono);
  }
  /* Shiki renders the <code> elements, so they carry no scoped-style attribute. */
  pre :global(code) { font: inherit; }
  .agent-prompt {
    padding-block: var(--space-xs);
    padding-inline: var(--space-s);
    border: 1px solid var(--glass-edge);
    border-radius: .65rem;
    background-color: color-mix(in oklch, var(--paper) 65%, oklch(none none none / 0));
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  /* Fade the right edge while a command block has more to scroll. */
  @property --code-fade {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
  @keyframes code-fade {
    from, 96% { --code-fade: var(--space-l); }
    to { --code-fade: 0px; }
  }
  @supports (animation-timeline: scroll()) {
    .steps pre {
      animation: code-fade linear both;
      animation-timeline: scroll(self inline);
      mask-image: linear-gradient(to left in oklch, oklch(0% 0 0 / 0), oklch(0% 0 0) var(--code-fade));
    }
    /* The mask would clip the focus ring. */
    .steps pre:focus-visible { mask-image: none; }
  }
  /* Phones: the copy button follows the intro. Wider cards: it sits beside the heading. */
  .agent .copy-prompt { margin-block-start: var(--space-s); }
  @media (min-width: 48rem) {
    .agent {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-xs);
    }
    .agent > :not(h2, .copy-prompt) { grid-column: 1 / -1; }
    .agent .copy-prompt { grid-area: 1 / 2; margin-block-start: 0; }
  }
</style>

<script>
  const prompt = document.getElementById('agent-prompt');
  const button = document.querySelector<HTMLButtonElement>('.copy-prompt');
  const status = document.getElementById('copy-prompt-status');

  if (prompt && button && status) {
    let feedbackTimer: number | undefined;

    const copyPrompt = async () => {
      let message: string;
      try {
        await navigator.clipboard.writeText(prompt.textContent ?? '');
        message = 'Copied';
      } catch {
        message = 'Copy failed. Select the prompt to copy it.';
      }
      clearTimeout(feedbackTimer);
      status.textContent = status.textContent === message ? message + '\u00a0' : message;
      feedbackTimer = window.setTimeout(() => { status.textContent = ''; }, 3000);
    };

    if ('commandForElement' in HTMLButtonElement.prototype) {
      prompt.addEventListener('command', copyPrompt);
    } else {
      button.addEventListener('click', copyPrompt);
    }
    button.hidden = false;
  }
</script>
