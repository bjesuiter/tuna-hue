<div class="demo" data-light-demo data-lit="true">
  <div class="stage" aria-hidden="true">
    <div class="orbit"></div>
    <canvas></canvas>
    <div class="bulb bulb-violet"><span class="glass"></span><span class="base"></span></div>
    <div class="bulb bulb-lemon"><span class="glass"></span><span class="base"></span></div>
    <div class="bulb bulb-pink"><span class="glass"></span><span class="base"></span></div>
  </div>
  <div class="console">
    <p class="caption">Interactive demo</p>
    <button type="button" disabled>
      <span class="room"><strong>Living Room</strong><small>Hue Room</small></span>
      <span class="action"><span data-action>Turn Off</span> <span aria-hidden="true">↵</span></span>
    </button>
  </div>
  <span class="visually-hidden" role="status"></span>
</div>

<style>
  .demo {
    position: relative;
    display: grid;
    align-content: space-between;
    aspect-ratio: 1.26;
    gap: .75rem;
    padding: clamp(.9rem, 3vw, 1.7rem);
    border: 1px solid var(--ink);
    border-radius: 1rem;
    box-shadow: 8px 8px var(--ink);
    background: radial-gradient(ellipse at 56% 36%, #fff 5%, #f7f6fb 80%);
    isolation: isolate;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 12rem;
    aspect-ratio: 1.65;
  }
  .stage canvas, .orbit { position: absolute; inset: 0; width: 100%; height: 100%; }
  .orbit {
    inset: 18% 8%;
    width: auto;
    height: auto;
    border: 1px solid #cdcad9;
    border-radius: 50%;
    rotate: -14deg;
    box-shadow: 0 0 0 13px #dedbe449, 0 0 0 26px #dedbe430;
    background: radial-gradient(ellipse at 60% 60%, #fff0 48%, #efd4ff60 73%, transparent 76%);
  }

  .bulb {
    display: grid;
    justify-items: center;
    position: absolute;
    width: 24%;
    aspect-ratio: .72;
    rotate: var(--tilt);
    scale: var(--size, 1);
    filter: drop-shadow(10px 12px 10px #24183f35);
  }
  .bulb-violet { top: 18%; left: 16%; --tilt: -28deg; --size: .7; --glass: #a69aff; --rim: #5947ac; --glow: #c4b7ff90; }
  .bulb-lemon { top: 6%; left: 38%; --tilt: 15deg; --glass: #efff80; --rim: #96a627; --glow: #dfff5690; }
  .bulb-pink { top: 10%; left: 65%; --tilt: 38deg; --size: .57; --glass: #ffc0dc; --rim: #ba588a; --glow: #ffb0d290; }

  .glass {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    border-radius: 50% 50% 34% 34% / 44% 44% 53% 53%;
    background:
      radial-gradient(ellipse at 27% 24%, #fff 0 5%, #fff9 10%, transparent 28%),
      radial-gradient(ellipse at 36% 38%, white, var(--glass) 48%, var(--rim) 105%);
    box-shadow: inset 0 0 0 1px #16151a30, 0 0 32px var(--glow);
  }
  .glass::after {
    content: '';
    position: absolute;
    inset: 50% 39% 8%;
    border: 2px solid #45426070;
    border-bottom: 0;
    border-radius: 45% 45% 0 0;
  }
  .base {
    width: 46%;
    height: 88%;
    margin-top: -4%;
    border-radius: 0 0 40% 40%;
    border: 1px solid #292630;
    background:
      linear-gradient(90deg, #16151a85, #fffc 25%, #fff2 50%, #16151aa0 90%),
      repeating-linear-gradient(-8deg, #a5a1ad 0 4px, #494653 5px 8px);
  }
  [data-lit="false"] .bulb { --glass: #e3e0e9; --rim: #a09aa9; --glow: transparent; }

  .console {
    position: relative;
    justify-self: center;
    width: min(100%, 24rem);
    padding: .65rem;
    border: 1px solid var(--ink);
    border-radius: .6rem;
    background: white;
    box-shadow: 4px 4px var(--ink);
  }
  .caption {
    padding: .15rem .35rem .55rem;
    color: var(--muted-ink);
    font: 600 .65rem/1.4 ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: .06em;
  }
  button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    text-align: start;
    gap: .5rem;
    border-radius: .35rem;
    padding: .65rem .75rem;
    border: 1px solid #dcd8e5;
    background: #f1eef8;
    color: var(--ink);
    cursor: pointer;
  }
  button:hover:not(:disabled) { background: #e8e1f8; }
  button:disabled { cursor: default; }
  .room { display: grid; line-height: 1.25; }
  .room small { color: var(--muted-ink); }
  .action { font-size: .85rem; font-weight: 700; white-space: nowrap; }
  .action [aria-hidden] { margin-inline-start: .2rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (max-width: 30rem) {
    .demo { aspect-ratio: auto; }
  }
</style>

<script>
  import { createOrbit } from './orbit';

  for (const demo of document.querySelectorAll<HTMLElement>('[data-light-demo]')) {
    const canvas = demo.querySelector('canvas')!;
    const button = demo.querySelector('button')!;
    const action = demo.querySelector('[data-action]')!;
    const status = demo.querySelector('[role="status"]')!;
    const bulbs = demo.querySelectorAll('.bulb');
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    const orbit = createOrbit(canvas);
    let lit = true;
    let frame = 0;

    function paint() {
      orbit?.draw(lit ? 1 : 0, 0);
    }

    new ResizeObserver(paint).observe(canvas);
    button.disabled = false;
    button.addEventListener('click', () => {
      lit = !lit;
      demo.dataset.lit = String(lit);
      action.textContent = lit ? 'Turn Off' : 'Turn On';
      status.textContent = lit ? 'Living Room lights are on.' : 'Living Room lights are off.';

      cancelAnimationFrame(frame);
      for (const bulb of bulbs) {
        for (const animation of bulb.getAnimations()) animation.cancel();
      }
      if (!motion.matches) {
        paint();
        return;
      }

      if (lit) {
        bulbs.forEach((bulb, index) => bulb.animate([
          { transform: 'translate(-8%, 18%) scale(.72) rotate(-12deg)' },
          { transform: 'translate(3%, -8%) scale(1.05) rotate(5deg)', offset: .67 },
          { transform: 'none' },
        ], { duration: 520, delay: index * 85, easing: 'ease-out' }));
      }

      if (!orbit) return;
      const start = performance.now();
      function animate(now: number) {
        const progress = Math.min((now - start) / 1000, 1);
        const intensity = lit ? progress : 1 - progress;
        if (!motion.matches || progress === 1) {
          paint();
          return;
        }
        orbit?.draw(intensity, progress);
        frame = requestAnimationFrame(animate);
      }
      frame = requestAnimationFrame(animate);
    });

    motion.addEventListener('change', () => {
      cancelAnimationFrame(frame);
      for (const bulb of bulbs) {
        for (const animation of bulb.getAnimations()) animation.cancel();
      }
      paint();
    });
  }
</script>
