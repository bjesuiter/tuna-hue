---
import LampGlobe from './LampGlobe.astro';
---
<div class="demo" data-light-demo>
  <div class="stage">
    <div class="wash" aria-hidden="true"></div>
    <div class="water" aria-hidden="true"></div>
    <canvas aria-hidden="true"></canvas>
    <button class="fixture" type="button" aria-label="Turn Off Living Room lights" disabled>
      <LampGlobe />
    </button>
  </div>
  <div class="demo-controls">
    <p class="caption">Interactive demo</p>
    <button class="console glass-control" type="button" disabled>
      <span class="room"><strong>Living Room</strong><small>Hue Room</small></span>
      <span class="action"><span data-action>Turn Off</span> <span aria-hidden="true">↵</span></span>
    </button>
  </div>
  <span class="visually-hidden" role="status"></span>
</div>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    position: relative;
    width: 100%;
    isolation: isolate;
    padding-bottom: 1rem;
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 16rem;
    aspect-ratio: 1.35;
  }
  .wash, canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wash { mask-image: radial-gradient(ellipse closest-side in oklch, oklch(0% 0 0) 30%, oklch(none none none / 0) 100%); }
  :global([data-lamp="off"]) .wash { opacity: 0; }

  .water {
    position: absolute;
    inset: 57% 4% 3%;
    opacity: 0;
    background:
      radial-gradient(ellipse 11% 4% at 51% 48% in oklch, oklch(95.04% 0.0254 244.4 / 0.369), oklch(none none none / 0)),
      radial-gradient(ellipse 18% 5% at 49% 63% in oklch, oklch(86.27% 0.0701 250.6 / 0.388), oklch(none none none / 0)),
      radial-gradient(ellipse 25% 4% at 51% 78% in oklch, oklch(82.33% 0.0703 251.3 / 0.329), oklch(none none none / 0)),
      radial-gradient(ellipse 47% 36% at 50% 70% in oklch, oklch(62.38% 0.0905 253.9 / 0.22), oklch(none none none / 0) 100%);
  }
  :global([data-lamp="off"]) .water { opacity: 1; }

  .fixture {
    position: relative;
    display: grid;
    justify-items: center;
    width: 46%;
    max-width: 17rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: oklch(none none none / 0);
    z-index: 1;
  }
  .wash {
    background:
      radial-gradient(ellipse at 34% 62% in oklch, oklch(89% 0.088 58 / 0.549), oklch(none none none / 0) 53%),
      radial-gradient(ellipse at 65% 55% in oklch, oklch(88.8% 0.081 311 / 0.455), oklch(none none none / 0) 50%),
      radial-gradient(ellipse at 79% 72% in oklch, oklch(90% 0.082 175 / 0.439), oklch(none none none / 0) 45%);
  }
  .demo-controls { width: min(100%, 23rem); }
  .caption {
    margin: 0 .3rem .5rem;
    color: var(--muted-ink);
    font: 650 .65rem/1.4 ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: .06em;
    text-align: start;
  }
  .console {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    text-align: start;
    gap: .5rem;
    border-radius: .9rem;
    padding: .95rem 1rem;
    color: var(--ink);
  }
  button:enabled { cursor: pointer; }
  @media (hover: hover) {
    .fixture:enabled:hover :global(.lamp-transition) { filter: brightness(1.025); }
    :global([data-lamp="off"]) .fixture:enabled:hover :global(.lamp-transition) { filter: brightness(1.08); }
  }
  button:enabled:active { filter: brightness(.93); }
  .room { display: grid; line-height: 1.25; }
  .room small { color: var(--muted-ink); }
  .action { font-size: .85rem; font-weight: 700; white-space: nowrap; }
  .action [aria-hidden] { margin-inline-start: .2rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .wash, .water { transition: opacity 500ms ease; }
  }
</style>

<script>
  import { createAmbientLight } from './ambient-light';
  import { setLamp } from './lamp-state';

  for (const demo of document.querySelectorAll<HTMLElement>('[data-light-demo]')) {
    const canvas = demo.querySelector('canvas')!;
    const globe = demo.querySelector<HTMLButtonElement>('.fixture')!;
    const consoleButton = demo.querySelector<HTMLButtonElement>('.console')!;
    const action = demo.querySelector('[data-action]')!;
    const status = demo.querySelector('[role="status"]')!;
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    const ambient = createAmbientLight(canvas);
    let lit = document.documentElement.dataset.lamp !== 'off';
    let visible = true;
    let paused = false;
    let frame = 0;
    let lastFrame = 0;
    let lightLevel = Number(lit);
    let waterTime = 0;
    let playbackRate = 1;

    function paint() {
      ambient?.draw(lightLevel, waterTime);
    }

    function render(now: number) {
      frame = 0;
      const target = Number(lit);
      const elapsed = Math.min(now - lastFrame, 50);
      lastFrame = now;
      const moving = Boolean(ambient) && motion.matches && !paused && visible;

      if (moving) {
        const step = elapsed / 500;
        lightLevel += Math.max(-step, Math.min(step, target - lightLevel));
        if (!lit) waterTime = (waterTime + elapsed * playbackRate / 1000) % (40 * Math.PI);
      } else {
        lightLevel = target;
      }
      paint();
      if (moving && (!lit || lightLevel !== target)) frame = requestAnimationFrame(render);
    }

    function updateScene() {
      cancelAnimationFrame(frame);
      lastFrame = performance.now();
      render(lastFrame);
    }

    if (ambient) {
      new ResizeObserver(paint).observe(canvas);
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        updateScene();
      }).observe(canvas);
      motion.addEventListener('change', updateScene);
      document.addEventListener('ambient-motion-change', event => {
        const detail = (event as CustomEvent<{ paused: boolean; playbackRate: number }>).detail;
        playbackRate = detail.playbackRate;
        if (paused !== detail.paused) {
          paused = detail.paused;
          updateScene();
        }
      });
    }

    function updateControls() {
      action.textContent = lit ? 'Turn Off' : 'Turn On';
      globe.setAttribute('aria-label', `${action.textContent} Living Room lights`);
    }

    function toggleLights() {
      lit = !lit;
      setLamp(lit);
      updateControls();
      status.textContent = lit ? 'Living Room lights are on.' : 'Living Room lights are off.';

      updateScene();
    }

    updateControls();
    for (const button of [globe, consoleButton]) {
      button.disabled = false;
      button.addEventListener('click', toggleLights);
    }
  }
</script>
