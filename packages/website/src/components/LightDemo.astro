<div class="demo" data-light-demo data-lit="true">
  <div class="stage" aria-hidden="true">
    <div class="wash"></div>
    <canvas></canvas>
    <div class="fixture">
      <span class="shade"></span>
    </div>
  </div>
  <div class="console">
    <p class="caption">Interactive demo</p>
    <button type="button" disabled>
      <span class="room"><strong>Living Room</strong><small>Hue Room</small></span>
      <span class="action"><span data-action>Turn Off</span> <span aria-hidden="true">↵</span></span>
    </button>
  </div>
  <span class="visually-hidden" role="status"></span>
</div>

<style>
  .demo {
    display: grid;
    justify-items: center;
    position: relative;
    width: 100%;
    isolation: isolate;
    padding-bottom: 1rem;
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 16rem;
    aspect-ratio: 1.35;
  }
  .wash, canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: radial-gradient(ellipse closest-side, black 30%, transparent 100%);
  }
  [data-lit="false"] .wash { opacity: .22; }

  .fixture {
    position: relative;
    display: grid;
    justify-items: center;
    width: 46%;
    max-width: 17rem;
    z-index: 1;
  }
  .wash {
    background:
      radial-gradient(ellipse at 34% 62%, #fdd6b68c, transparent 53%),
      radial-gradient(ellipse at 65% 55%, #e7cff874, transparent 50%),
      radial-gradient(ellipse at 79% 72%, #c3e8df70, transparent 45%);
  }
  .shade {
    width: 100%;
    border: 1px solid #fff9;
    aspect-ratio: 1.06;
    border-radius: 50%;
    background: radial-gradient(circle at 37% 32%, white 16%, #fcf4ed 48%, #e4cbc5 76%, #c8a9b5 100%);
    box-shadow: 0 8px 34px #f2ccd078, inset -10px -12px 22px #c2a4b230;
  }
  [data-lit="false"] .shade { filter: brightness(.9); box-shadow: none; }

  .console {
    width: min(100%, 23rem);
    padding: .72rem;
    border: 1px solid var(--line);
    border-radius: .9rem;
    background: #fffe;
    box-shadow: var(--soft-shadow);
  }
  .caption {
    padding: .1rem .3rem .5rem;
    color: var(--muted-ink);
    font: 650 .65rem/1.4 ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: .06em;
    text-align: start;
  }
  button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    text-align: start;
    gap: .5rem;
    border-radius: .5rem;
    padding: .65rem .75rem;
    border: 1px solid var(--line);
    background: var(--accent);
    color: var(--ink);
    cursor: pointer;
  }
  button:hover:not(:disabled) { background: white; }
  button:disabled { cursor: default; }
  .room { display: grid; line-height: 1.25; }
  .room small { color: var(--muted-ink); }
  .action { font-size: .85rem; font-weight: 700; white-space: nowrap; }
  .action [aria-hidden] { margin-inline-start: .2rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .wash { transition: opacity 450ms ease; }
    .shade { transition: filter 450ms ease, box-shadow 450ms ease; }
  }
</style>

<script>
  import { createAmbientLight } from './ambient-light';

  for (const demo of document.querySelectorAll<HTMLElement>('[data-light-demo]')) {
    const canvas = demo.querySelector('canvas')!;
    const button = demo.querySelector('button')!;
    const action = demo.querySelector('[data-action]')!;
    const status = demo.querySelector('[role="status"]')!;
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    const ambient = createAmbientLight(canvas);
    let lit = true;
    let frame = 0;
    let lightLevel = 1;

    function paint() {
      ambient?.draw(lightLevel);
    }

    if (ambient) new ResizeObserver(paint).observe(canvas);
    button.disabled = false;
    button.addEventListener('click', () => {
      lit = !lit;
      demo.dataset.lit = String(lit);
      action.textContent = lit ? 'Turn Off' : 'Turn On';
      status.textContent = lit ? 'Living Room lights are on.' : 'Living Room lights are off.';

      cancelAnimationFrame(frame);
      const target = Number(lit);
      if (!ambient || !motion.matches) {
        lightLevel = target;
        paint();
        return;
      }

      const start = performance.now();
      const from = lightLevel;
      function animate(now: number) {
        const progress = motion.matches ? Math.min((now - start) / 500, 1) : 1;
        lightLevel = from + (target - from) * progress;
        paint();
        if (progress < 1) frame = requestAnimationFrame(animate);
      }
      frame = requestAnimationFrame(animate);
    });
  }
</script>
