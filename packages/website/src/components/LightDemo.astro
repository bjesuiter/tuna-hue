<div class="demo" data-light-demo data-lit="true">
  <div class="stage" aria-hidden="true">
    <div class="wash"></div>
    <div class="water"></div>
    <canvas></canvas>
    <div class="fixture">
      <span class="shade"></span>
    </div>
  </div>
  <div class="console glass-panel">
    <p class="caption">Interactive demo</p>
    <button class="glass-control" type="button" disabled>
      <span class="room"><strong>Living Room</strong><small>Hue Room</small></span>
      <span class="action"><span data-action>Turn Off</span> <span aria-hidden="true">↵</span></span>
    </button>
  </div>
  <span class="visually-hidden" role="status"></span>
</div>

<style>
  .demo {
    display: grid;
    justify-items: center;
    position: relative;
    width: 100%;
    isolation: isolate;
    padding-bottom: 1rem;
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 16rem;
    aspect-ratio: 1.35;
  }
  .wash, canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wash { mask-image: radial-gradient(ellipse closest-side, black 30%, transparent 100%); }
  [data-lit="false"] .wash { opacity: 0; }

  .water {
    position: absolute;
    inset: 57% 4% 3%;
    opacity: 0;
    background:
      radial-gradient(ellipse 11% 4% at 51% 48%, #e1f1ff5e, transparent),
      radial-gradient(ellipse 18% 5% at 49% 63%, #b0d6ff63, transparent),
      radial-gradient(ellipse 25% 4% at 51% 78%, #a4c9f254, transparent),
      radial-gradient(ellipse 47% 36% at 50% 70%, #608abd38, transparent 100%);
  }
  [data-lit="false"] .water { opacity: 1; }

  .fixture {
    position: relative;
    display: grid;
    justify-items: center;
    width: 46%;
    max-width: 17rem;
    z-index: 1;
  }
  .wash {
    background:
      radial-gradient(ellipse at 34% 62%, #fdd6b68c, transparent 53%),
      radial-gradient(ellipse at 65% 55%, #e7cff874, transparent 50%),
      radial-gradient(ellipse at 79% 72%, #c3e8df70, transparent 45%);
  }
  .shade {
    position: relative;
    width: 100%;
    border: 1px solid #fff9;
    aspect-ratio: 1.06;
    border-radius: 50%;
    background: radial-gradient(circle at 37% 32%, white 16%, #fcf4ed 48%, #e4cbc5 76%, #c8a9b5 100%);
    box-shadow: 0 8px 34px #f2ccd078, inset -10px -12px 22px #c2a4b230;
  }
  .shade::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid #7e9abe88;
    background: radial-gradient(circle at 33% 25%, #556d87 0%, #253b55 48%, #101b2e 78%);
    box-shadow: inset 2px 2px 6px #d8ebff99, 0 8px 40px #94bffa35;
    opacity: 0;
  }
  [data-lit="false"] .shade { box-shadow: none; }
  [data-lit="false"] .shade::after { opacity: 1; }

  .console {
    width: min(100%, 23rem);
    padding: .72rem;
    border-radius: .9rem;
  }
  .caption {
    padding: .1rem .3rem .5rem;
    color: var(--muted-ink);
    font: 650 .65rem/1.4 ui-monospace, monospace;
    text-transform: uppercase;
    letter-spacing: .06em;
    text-align: start;
  }
  button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    text-align: start;
    gap: .5rem;
    border-radius: .5rem;
    padding: .65rem .75rem;
    color: var(--ink);
    cursor: pointer;
  }
  button:disabled { cursor: default; }
  .room { display: grid; line-height: 1.25; }
  .room small { color: var(--muted-ink); }
  .action { font-size: .85rem; font-weight: 700; white-space: nowrap; }
  .action [aria-hidden] { margin-inline-start: .2rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .wash, .water, .shade::after { transition: opacity 500ms ease; }
    .shade { transition: box-shadow 500ms ease; }
  }
</style>

<script>
  import { createAmbientLight } from './ambient-light';

  for (const demo of document.querySelectorAll<HTMLElement>('[data-light-demo]')) {
    const canvas = demo.querySelector('canvas')!;
    const button = demo.querySelector('button')!;
    const action = demo.querySelector('[data-action]')!;
    const status = demo.querySelector('[role="status"]')!;
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    const ambient = createAmbientLight(canvas);
    let lit = true;
    let visible = true;
    let paused = false;
    let frame = 0;
    let lastFrame = 0;
    let lightLevel = 1;
    let waterTime = 0;

    function paint() {
      ambient?.draw(lightLevel, waterTime);
    }

    function render(now: number) {
      frame = 0;
      const target = Number(lit);
      const elapsed = Math.min(now - lastFrame, 50);
      lastFrame = now;
      const moving = Boolean(ambient) && motion.matches && !paused && visible;

      if (moving) {
        const step = elapsed / 500;
        lightLevel += Math.max(-step, Math.min(step, target - lightLevel));
        if (!lit) waterTime = (waterTime + elapsed / 1000) % (40 * Math.PI);
      } else {
        lightLevel = target;
      }
      paint();
      if (moving && (!lit || lightLevel !== target)) frame = requestAnimationFrame(render);
    }

    function updateScene() {
      cancelAnimationFrame(frame);
      lastFrame = performance.now();
      render(lastFrame);
    }

    if (ambient) {
      new ResizeObserver(paint).observe(canvas);
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        updateScene();
      }).observe(canvas);
      motion.addEventListener('change', updateScene);
      document.addEventListener('ambient-motion-change', event => {
        paused = (event as CustomEvent<boolean>).detail;
        updateScene();
      });
    }

    button.disabled = false;
    button.addEventListener('click', () => {
      lit = !lit;
      demo.dataset.lit = String(lit);
      action.textContent = lit ? 'Turn Off' : 'Turn On';
      status.textContent = lit ? 'Living Room lights are on.' : 'Living Room lights are off.';

      updateScene();
    });
  }
</script>
