---
import JourneyImagePreview from './JourneyImagePreview.astro';
import JourneyShots from './JourneyShots.astro';
import findCommandLight from '../assets/screenshots/01-find-hue-command-light.png';
import findCommandDark from '../assets/screenshots/01-find-hue-command-dark.png';
import chooseBridgeLight from '../assets/screenshots/02-choose-bridge-light.png';
import chooseBridgeDark from '../assets/screenshots/02-choose-bridge-dark.png';
import pressButtonLight from '../assets/screenshots/03-press-link-button-light.png';
import pressButtonDark from '../assets/screenshots/03-press-link-button-dark.png';
import connectedLight from '../assets/screenshots/04-bridge-connected-light.png';
import connectedDark from '../assets/screenshots/04-bridge-connected-dark.png';
import turnOnLight from '../assets/screenshots/05-turn-on-light.png';
import turnOnDark from '../assets/screenshots/05-turn-on-dark.png';
import turnOffLight from '../assets/screenshots/06-turn-off-light.png';
import turnOffDark from '../assets/screenshots/06-turn-off-dark.png';
import manualLight from '../assets/screenshots/07-manual-connection-light.png';
import manualDark from '../assets/screenshots/07-manual-connection-dark.png';
import checkConnectionLight from '../assets/screenshots/08-check-connection-light.png';
import checkConnectionDark from '../assets/screenshots/08-check-connection-dark.png';
import manageBridgesLight from '../assets/screenshots/09-manage-bridges-light.png';
import manageBridgesDark from '../assets/screenshots/09-manage-bridges-dark.png';
import disconnectLight from '../assets/screenshots/10-disconnect-bridge-light.png';
import disconnectDark from '../assets/screenshots/10-disconnect-bridge-dark.png';

const installHref = import.meta.env.BASE_URL.replace(/\/$/, '') + '/install/';
---

<section class="journey page-content" aria-labelledby="walkthrough">
  <h1 id="walkthrough">From bridge to light switch.</h1>
  <p>See how Tuna Hue Control pairs with your Hue Bridge and lets you switch rooms and zones from Tuna.</p>

  <ol class="steps" role="list">
    <li class="card glass-panel glass-rainbow">
      <div class="step-copy">
        <span class="number label" aria-hidden="true">01</span>
        <h2>Find Hue in Tuna</h2>
        <p>Once the extension is installed, open Tuna, search for <strong>Hue</strong>, and run <strong>Connect First Hue Bridge</strong>.</p>
        <p>If the command is missing, set <strong>Sources → Hue Groups → In global search</strong> to <strong>All</strong>.</p>
      </div>
      <JourneyShots shots={[
        { light: findCommandLight, dark: findCommandDark, previewBounds: [328, 112, 928, 496], alt: 'Connect First Hue Bridge selected in Tuna search.' },
      ]} />
    </li>

    <li class="card glass-panel glass-rainbow">
      <div class="step-copy">
        <span class="number label" aria-hidden="true">02</span>
        <h2>Pair your bridge</h2>
        <p>Keep your Mac and bridge on the same network. Allow local network access if macOS asks. Select your bridge, choose <strong>Continue</strong>, then press the physical link button when prompted.</p>
      </div>
      <JourneyShots shots={[
        { light: chooseBridgeLight, dark: chooseBridgeDark, previewBounds: [96, 60, 936, 777], alt: 'Add Hue Bridge dialog with a discovered bridge selected.', caption: 'Choose your bridge' },
        { light: pressButtonLight, dark: pressButtonDark, previewBounds: [96, 60, 936, 784], alt: 'Tuna shows where to press the physical link button on a Hue Bridge.', caption: 'Press the link button' },
        { light: connectedLight, dark: connectedDark, previewBounds: [96, 60, 552, 417], alt: 'Tuna confirms that the Hue Bridge is connected.', caption: 'Finish pairing' },
      ]} />
    </li>

    <li class="card glass-panel glass-rainbow">
      <div class="step-copy">
        <span class="number label" aria-hidden="true">03</span>
        <h2>Control a room or zone</h2>
        <p>Search by name and look for <strong>Hue Room</strong> or <strong>Hue Zone</strong> in the result details. Press <kbd>Tab</kbd> to choose an available action and <kbd>Return</kbd> to run it.</p>
      </div>
      <JourneyShots shots={[
        { light: turnOnLight, dark: turnOnDark, previewBounds: [19, 4, 928, 491], alt: 'A bedroom selected with the Turn On action.', caption: 'Turn on a room' },
        { light: turnOffLight, dark: turnOffDark, thumbBounds: [328, 112, 928, 496], previewBounds: [328, 112, 928, 1428], alt: 'A living-room group selected with the Turn Off action.', caption: 'Turn off a group' },
      ]} />
    </li>
  </ol>

  <a class="pill" href={installHref} data-lamp-link>Install now <span aria-hidden="true">→</span></a>

  <section class="help" aria-labelledby="help-title">
    <h2 id="help-title">Bridge setup and troubleshooting</h2>
    <div class="faq card glass-panel glass-rainbow">
      <details>
        <summary>
          <span class="label" aria-hidden="true">Q1</span>
          <span class="question">My bridge doesn’t appear</span>
          <span class="indicator" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </summary>
        <div class="answer">
          <p>Choose <strong>Refresh</strong> in the bridge picker. You can also select <strong>Enter IP Address…</strong> and supply the local address, bridge ID, and Hue application key.</p>
          <JourneyShots shots={[
            { light: manualLight, dark: manualDark, previewBounds: [96, 60, 736, 981], alt: 'Manual Connect Bridge form with blank address, bridge ID, optional certificate path, and application key fields.', caption: 'Enter bridge details manually' },
          ]} />
        </div>
      </details>
      <details>
        <summary>
          <span class="label" aria-hidden="true">Q2</span>
          <span class="question">My lights show as offline</span>
          <span class="indicator" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </summary>
        <div class="answer">
          <p>Choose <strong>Check Connection</strong> to fetch the latest status. Power actions return when at least one light in the group is reachable.</p>
          <JourneyShots shots={[
            { light: checkConnectionLight, dark: checkConnectionDark, thumbBounds: [328, 112, 928, 496], previewBounds: [328, 112, 928, 1428], alt: 'A kitchen room selected with the Check Connection action.', caption: 'Refresh the room’s connection status' },
          ]} />
        </div>
      </details>
      <details>
        <summary>
          <span class="label" aria-hidden="true">Q3</span>
          <span class="question">I want to add or disconnect a bridge</span>
          <span class="indicator" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </summary>
        <div class="answer">
          <p>Run <strong>Add Hue Bridge</strong> to connect another bridge. To remove one, run <strong>Manage Hue Bridges</strong>, select the bridge, and confirm <strong>Disconnect</strong>. Tuna removes its saved application key from this Mac.</p>
          <JourneyShots shots={[
            { light: manageBridgesLight, dark: manageBridgesDark, previewBounds: [96, 60, 816, 521], alt: 'Manage Hue Bridges dialog with a connected bridge selected.', caption: 'Select the bridge to remove' },
            { light: disconnectLight, dark: disconnectDark, previewBounds: [96, 60, 552, 501], alt: 'Disconnect confirmation explaining that Tuna removes the saved application key.', caption: 'Confirm disconnect' },
          ]} />
        </div>
      </details>
    </div>
  </section>
</section>
<JourneyImagePreview />

<style>
  h1 { max-width: 15ch; }
  .steps { list-style: none; margin: var(--section-gap) 0; padding: 0; display: grid; gap: var(--space-l); }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(var(--space-s), 3vw, var(--space-xl));
  }
  .number { display: block; margin-bottom: var(--space-xs); color: var(--muted-ink); }
  p { margin-top: var(--space-xs); color: var(--muted-ink); max-width: 65ch; }
  kbd { color: var(--ink); font-weight: var(--weight-semibold); }
  .help { margin-top: var(--section-gap); }
  .help h2 { margin-bottom: var(--space-m); }
  .faq { --faq-marker: 2rem; padding-block: var(--space-2xs); }
  details + details { border-top: 1px solid var(--line); }
  summary {
    display: grid;
    grid-template-columns: var(--faq-marker) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xs);
    min-block-size: calc(var(--tap-target) + var(--space-s));
    /* Inline padding with matching negative margin keeps the focus ring off the text. */
    margin-inline: calc(-1 * var(--space-2xs));
    padding: var(--space-xs) var(--space-2xs);
    list-style: none;
    border-radius: var(--space-2xs);
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline-offset: 2px; }
  summary .label { color: var(--muted-ink); }
  .question { font-size: var(--text-l); font-weight: var(--weight-semibold); line-height: 1.3; }
  summary:hover .question { text-decoration: underline; text-underline-offset: .2em; }
  .indicator {
    display: grid;
    place-items: center;
    inline-size: var(--tap-target);
    block-size: var(--tap-target);
    border: 1px solid var(--glass-edge);
    border-radius: 50%;
    background-color: var(--glass-control);
    box-shadow: inset 0 1px 0 var(--glass-control-glint);
  }
  summary:hover .indicator { background-color: var(--glass-control-hover); }
  details[open] .indicator svg { rotate: 180deg; }
  @media (prefers-reduced-motion: no-preference) {
    .indicator svg { transition: rotate .2s ease; }
  }
  .answer {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-3xs) 0 var(--space-l) calc(var(--faq-marker) + var(--space-xs));
  }
  .answer p { margin: 0; }
  /* Steps and answers need more room than the site-wide 48rem breakpoint to sit beside screenshots. */
  @media (min-width: 52rem) {
    li { grid-template-columns: minmax(12rem, 1fr) minmax(0, 2.4fr); }
    .answer { grid-template-columns: minmax(12rem, 1fr) minmax(0, 2.4fr); align-items: start; column-gap: var(--space-xl); }
  }
</style>
