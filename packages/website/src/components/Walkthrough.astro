---
import JourneyShots from './JourneyShots.astro';
import findCommand from '../assets/screenshots/find-hue-command.png';
import chooseBridge from '../assets/screenshots/choose-bridge.png';
import pressButton from '../assets/screenshots/press-link-button.png';
import connected from '../assets/screenshots/bridge-connected.png';
import turnOn from '../assets/screenshots/turn-on.png';
import turnOff from '../assets/screenshots/turn-off.png';
import manual from '../assets/screenshots/manual-connection.png';
import checkConnection from '../assets/screenshots/check-connection.png';
import manageBridges from '../assets/screenshots/manage-bridges.png';
import disconnect from '../assets/screenshots/disconnect-bridge.png';
---

<section class="journey" aria-labelledby="walkthrough">
  <h1 id="walkthrough">From bridge to light switch.</h1>

  <ol class="steps" role="list">
    <li class="glass-panel glass-rainbow">
      <div class="step-copy">
        <span class="number" aria-hidden="true">01</span>
        <h2>Find Hue in Tuna</h2>
        <p>Once the extension is installed, open Tuna, search for <strong>Hue</strong>, and run <strong>Connect First Hue Bridge</strong>.</p>
        <p>If the command is missing, set <strong>Sources → Hue Groups → In global search</strong> to <strong>All</strong>.</p>
      </div>
      <JourneyShots shots={[
        { image: findCommand, crop: true, alt: 'Connect First Hue Bridge selected in Tuna search.', caption: 'Run the connection command' },
      ]} />
    </li>

    <li class="glass-panel glass-rainbow">
      <div class="step-copy">
        <span class="number" aria-hidden="true">02</span>
        <h2>Pair your bridge</h2>
        <p>Keep your Mac and bridge on the same network. Allow local network access if macOS asks. Select your bridge, choose <strong>Continue</strong>, then press the physical link button when prompted.</p>
      </div>
      <JourneyShots shots={[
        { image: chooseBridge, alt: 'Add Hue Bridge dialog with a discovered bridge selected.', caption: 'Choose your bridge' },
        { image: pressButton, alt: 'Tuna waiting for the physical link button press.', caption: 'Press the link button' },
        { image: connected, alt: 'Tuna confirms that the Hue Bridge is connected.', caption: 'Finish pairing' },
      ]} />
    </li>

    <li class="glass-panel glass-rainbow">
      <div class="step-copy">
        <span class="number" aria-hidden="true">03</span>
        <h2>Control a room or zone</h2>
        <p>Search by name and look for <strong>Hue Room</strong> or <strong>Hue Zone</strong> in the result details. Press <kbd>Tab</kbd> to choose an available action and <kbd>Return</kbd> to run it.</p>
      </div>
      <JourneyShots shots={[
        { image: turnOn, alt: 'A bedroom selected with the Turn On action.', caption: 'Turn on a room' },
        { image: turnOff, crop: true, alt: 'A living-room group selected with the Turn Off action.', caption: 'Turn off a group' },
      ]} />
    </li>
  </ol>

  <section class="help" aria-labelledby="help-title">
    <h2 id="help-title">Bridge setup and troubleshooting</h2>
    <details>
      <summary>My bridge doesn’t appear</summary>
      <p>Choose <strong>Refresh</strong> in the bridge picker. You can also select <strong>Enter IP Address…</strong> and supply the local address, bridge ID, and Hue application key.</p>
      <JourneyShots shots={[
        { image: manual, alt: 'Manual Connect Bridge form with blank address, bridge ID, optional certificate path, and application key fields.', caption: 'Enter bridge details manually' },
      ]} />
    </details>
    <details>
      <summary>My lights show as offline</summary>
      <p>Choose <strong>Check Connection</strong> to fetch the latest status. Power actions return when at least one light in the group is reachable.</p>
      <JourneyShots shots={[
        { image: checkConnection, crop: true, alt: 'A kitchen room selected with the Check Connection action.', caption: 'Refresh the room’s connection status' },
      ]} />
    </details>
    <details>
      <summary>I want to add or disconnect a bridge</summary>
      <p>Run <strong>Add Hue Bridge</strong> to connect another bridge. To remove one, run <strong>Manage Hue Bridges</strong>, select the bridge, and confirm <strong>Disconnect</strong>. Tuna removes its saved application key from this Mac.</p>
      <JourneyShots shots={[
        { image: manageBridges, alt: 'Manage Hue Bridges dialog with a connected bridge selected.', caption: 'Select the bridge to remove' },
        { image: disconnect, alt: 'Disconnect confirmation explaining that Tuna removes the saved application key.', caption: 'Confirm disconnect' },
      ]} />
    </details>
  </section>
</section>

<style>
  .journey { padding-block: clamp(2rem, 6vw, 5rem) 5rem; }
  h1, h2 { margin: 0; line-height: 1.05; letter-spacing: -.045em; }
  h1 { font-family: var(--heading-font); max-width: 15ch; font-size: clamp(2.75rem, 7vw, 6rem); }
  h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); }
  .steps { list-style: none; margin: 2.5rem 0; padding: 0; display: grid; gap: 1.25rem; }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: clamp(1.1rem, 3vw, 2.3rem);
    border-radius: 1rem;
  }
  .number {
    display: inline-grid;
    place-items: center;
    inline-size: 2.2rem;
    aspect-ratio: 1;
    margin-bottom: .85rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--accent);
    font: 700 .75rem ui-monospace, monospace;
  }
  p { margin-top: .75rem; color: var(--muted-ink); max-width: 65ch; }
  kbd { border: 1px solid var(--line); border-radius: .25rem; padding: .05em .3em; background: var(--shot-surface, #f7f6fb); }
  .help { margin-top: 3.5rem; }
  .help h2 { margin-bottom: 1rem; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { padding-block: .9rem; font-weight: 750; cursor: pointer; }
  details p { margin: 0 0 1rem; }
  details :global(.shots) { margin-bottom: 1.5rem; }
  @media (min-width: 52rem) {
    li { grid-template-columns: minmax(12rem, 1fr) minmax(0, 2.4fr); }
  }
</style>
