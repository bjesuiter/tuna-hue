---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shots: {
    image: ImageMetadata;
    alt: string;
    caption: string;
    crop?: boolean;
  }[];
}

const { shots } = Astro.props;
---
<div class="shots">
  {shots.map(({ image, alt, caption, crop }) => (
    <figure>
      <a class:list={['shot', { crop }]} href={image.src} aria-label={`Open full screenshot. ${alt}`}>
        <Image src={image} alt={alt} width={Math.min(960, image.width)} loading="lazy" />
      </a>
      <figcaption>{caption}</figcaption>
    </figure>
  ))}
</div>

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    gap: .85rem;
  }
  figure { margin: 0; min-width: 0; }
  .shot {
    display: grid;
    place-items: center;
    max-width: 30rem;
    aspect-ratio: 1.55;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: .75rem;
    background: radial-gradient(ellipse at 80% 95%, var(--shot-wash, #f2e5ff), transparent 70%), var(--shot-surface, #f7f6fb);
  }
  img { display: block; width: 100%; height: 100%; object-fit: contain; min-height: 0; }
  .crop { position: relative; }
  .crop img {
    position: absolute;
    width: 163%;
    max-width: none;
    height: auto;
    top: -21%;
    left: 50%;
    translate: -50% 0;
  }
  figcaption { margin-top: .45rem; font-size: .84rem; font-weight: 650; }
</style>
