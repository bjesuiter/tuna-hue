---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shots: {
    image: ImageMetadata;
    alt: string;
    caption?: string;
    crop?: boolean | 'tiles';
  }[];
}

const { shots } = Astro.props;
---
<div class="shots">
  {shots.map(({ image, alt, caption, crop }) => (
    <figure>
      <a class:list={['shot', { crop, 'tiles-only': crop === 'tiles' }]} href={image.src} data-image-preview aria-label={`Open full screenshot. ${alt}`}>
        <Image src={image} alt={alt} width={Math.min(960, image.width)} loading="lazy" />
      </a>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ))}
</div>

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr));
    gap: .85rem;
  }
  figure { margin: 0; min-width: 0; }
  .shot {
    display: grid;
    place-items: center;
    max-width: 30rem;
    aspect-ratio: 1.55;
    overflow: hidden;
    cursor: zoom-in;
  }
  img { display: block; width: 100%; height: 100%; object-fit: contain; min-height: 0; }
  .crop { position: relative; }
  .crop img {
    position: absolute;
    width: 163%;
    max-width: none;
    height: auto;
    top: -21%;
    left: 50%;
    translate: -50% 0;
  }
  .tiles-only { aspect-ratio: 1.95; }
  .tiles-only img { top: -22%; }
  figcaption { margin-top: .45rem; font-size: .84rem; font-weight: 650; }
</style>
