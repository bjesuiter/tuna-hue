---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Bounds = [x: number, y: number, width: number, height: number];

interface Props {
  shots: {
    light: ImageMetadata;
    dark: ImageMetadata;
    alt: string;
    caption?: string;
    /** The part of the screenshot the preview dialog shows, in image pixels. */
    previewBounds: Bounds;
    /** The part shown on the page, when it differs from `previewBounds`. */
    thumbBounds?: Bounds;
  }[];
}

// Thumbnails are at most 30rem wide; render the cropped part at about 2x that.
const thumbPixels = 960;
const shadow = 16;
// Leave room for the pastel backdrop and the shadow cast onto it.
const backdrop = 48;

function expandBounds([x, y, width, height]: Bounds, image: ImageMetadata): Bounds {
  const left = Math.max(0, x - backdrop);
  const top = Math.max(0, y - backdrop);
  const right = Math.min(image.width, x + width + backdrop);
  const bottom = Math.min(image.height, y + height + backdrop);
  return [left, top, right - left, bottom - top];
}

const shots = await Promise.all(Astro.props.shots.map(async shot => {
  const [bx, by, bw, bh] = shot.thumbBounds ?? shot.previewBounds;
  const variants = await Promise.all((['light', 'dark'] as const).map(async appearance => {
    const image = shot[appearance];
    const [x, y, width, height] = appearance === 'light'
      ? expandBounds([bx, by, bw, bh], image)
      : [bx + shadow, by + shadow, bw - 2 * shadow, bh - 2 * shadow];
    const preview = await getImage({ src: image, format: 'webp', quality: 90 });
    return {
      appearance,
      image,
      preview: preview.src,
      previewBounds: appearance === 'light' ? expandBounds(shot.previewBounds, image) : shot.previewBounds,
      renderWidth: Math.min(image.width, Math.ceil(thumbPixels * image.width / width)),
      crop: [
        `--aspect: ${width / height}`,
        `--left: ${-100 * x / width}%`,
        `--top: ${-100 * y / height}%`,
        `--width: ${100 * image.width / width}%`,
      ].join('; '),
    };
  }));
  return {
    ...shot,
    width: bw - 2 * shadow,
    variants,
  };
}));

// Columns as wide as each cropped screenshot, so a row shows every UI at the same scale.
// A minimum width keeps small dialogs legible next to large ones.
// Stacked on narrow screens, each keeps its width relative to the widest one.
const minColumn = `min(9rem, ${100 / shots.length}% - var(--space-s))`;
const columns = shots.map(({ width }) => `minmax(${minColumn}, ${width}fr)`).join(' ');
const widest = Math.max(...shots.map(({ width }) => width));
---
<div class="shots-area">
<div class:list={['shots', { single: shots.length === 1 }]} style={`--columns: ${columns}`}>
  {shots.map(({ variants, alt, caption, width }) => (
    <figure>
      {variants.map(({ appearance, image, preview, previewBounds, renderWidth, crop }) => (
        <a
          class="shot"
          data-appearance={appearance}
          style={`${crop}; --share: ${width / widest}`}
          href={preview}
          data-image-preview
          data-image-width={image.width}
          data-image-height={image.height}
          data-preview-bounds={previewBounds.join(' ')}
          aria-label={`Open screenshot preview. ${alt}`}
        >
          <Image src={image} alt={alt} width={renderWidth} loading="lazy" />
        </a>
      ))}
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ))}
</div>
</div>

<style>
  .shots-area { container-type: inline-size; }
  .shots {
    display: grid;
    gap: var(--space-m) var(--space-s);
  }
  /* Captions share a baseline: each image is centred in the space above its caption. */
  figure {
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    gap: var(--space-2xs);
    margin: 0;
    min-width: 0;
  }
  .shot {
    position: relative;
    align-self: center;
    --max-width: 30rem;
    inline-size: calc(var(--share) * 100%);
    /* Portrait screenshots stop at 24rem tall instead of 30rem wide. */
    max-inline-size: min(var(--max-width), calc(var(--aspect) * 24rem));
    aspect-ratio: var(--aspect);
    overflow: hidden;
    /* Round the screenshot frame. The light capture includes the window's own corners. */
    border-radius: 2.6% / calc(2.6% * var(--aspect));
    cursor: zoom-in;
  }
  .shot[data-appearance="dark"],
  :global(:root[data-lamp="off"]) .shot[data-appearance="light"] { display: none; }
  :global(:root[data-lamp="off"]) .shot[data-appearance="dark"] { display: block; }
  /* A lone screenshot stays near the size of one in a two-shot row. */
  .single .shot { --max-width: 24rem; }
  /* After the base .shot rule: in a row, the column already sets the scale. */
  @container (min-width: 26rem) {
    .shots { grid-template-columns: var(--columns); }
    .shot { inline-size: 100%; }
  }
  img {
    position: absolute;
    inset-inline-start: var(--left);
    inset-block-start: var(--top);
    inline-size: var(--width);
    max-inline-size: none;
    block-size: auto;
  }
  figcaption {
    font-size: var(--text-s);
    font-weight: var(--weight-semibold);
    text-align: center;
  }
</style>
