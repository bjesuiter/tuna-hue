<div data-ambient-background>
  <div class="field" aria-hidden="true">
    <span class="glow peach"></span>
    <span class="glow lilac"></span>
    <span class="glow mint"></span>
    <span class="glow blue"></span>
  </div>
  <button type="button" hidden>Pause ambient motion</button>
</div>

<style>
  [data-ambient-background] { position: relative; }
  .field {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(ellipse at 82% 22%, #fdf1e9, transparent 70%);
    filter: saturate(var(--page-saturation, 1));
    opacity: var(--ambient-opacity, 1);
  }
  .glow {
    position: absolute;
    inline-size: max(86vw, 29rem);
    block-size: max(102%, 32rem);
    background: radial-gradient(
      ellipse closest-side,
      var(--light) 0%,
      color-mix(in srgb, var(--light) 78%, transparent) 32%,
      color-mix(in srgb, var(--light) 24%, transparent) 69%,
      transparent 100%
    );
  }
  .peach { --light: #ffb191bb; inset: -29% auto auto -26%; }
  .lilac { --light: #c19afbc0; inset: 6% auto auto 4%; }
  .mint { --light: #83dfc7b0; inset: -12% -27% auto auto; }
  .blue { --light: #a2c9ffc4; inset: 42% auto auto 5%; }

  button {
    position: absolute;
    inset: .55rem 0 auto auto;
    z-index: 1;
    border: 0;
    border-radius: .35rem;
    padding: .25rem .4rem;
    color: var(--muted-ink);
    background: transparent;
    font-size: .75rem;
    cursor: pointer;
  }
  button:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: no-preference) {
    .field { transition: filter 450ms ease, opacity 450ms ease; }
  }
</style>

<script>
  function driftFrames(): Keyframe[] {
    const turn = 2 * Math.PI;
    const phases = Array.from({ length: 4 }, () => Math.random() * turn);

    // Whole harmonics let an irregular path loop without a jump.
    return Array.from({ length: 101 }, (_, index) => {
      const angle = index * turn / 100;
      const x = 40 * Math.sin(angle + phases[0]) + 14 * Math.sin(3 * angle + phases[1]);
      const y = 34 * Math.sin(angle + phases[2]) + 12 * Math.sin(2 * angle + phases[3]);
      return { transform: `translate(${x.toFixed(2)}%, ${y.toFixed(2)}%)` };
    });
  }

  const background = document.querySelector('[data-ambient-background]');
  if (background) {
    const button = background.querySelector('button')!;
    const glows = background.querySelectorAll('.glow');
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    let animations: Animation[] = [];
    let paused = false;
    let boost = 0;
    let requestedBoost = 0;
    let frame = 0;
    let lastFrame = 0;
    let lastScroll = window.scrollY;
    let lastScrollTime = 0;

    function resetSpeed() {
      cancelAnimationFrame(frame);
      frame = 0;
      boost = 0;
      requestedBoost = 0;
      for (const animation of animations) animation.updatePlaybackRate(1);
    }

    function updateMotion() {
      resetSpeed();
      for (const animation of animations) animation.cancel();
      animations = [];
      button.hidden = !motion.matches;
      if (!motion.matches) return;

      animations = Array.from(glows, glow => glow.animate(driftFrames(), {
        duration: 19000 + Math.random() * 12000,
        iterations: Infinity,
      }));
      if (paused) for (const animation of animations) animation.pause();
    }

    function easeSpeed(now: number) {
      if (now - lastScrollTime > 110) requestedBoost = 0;
      const ramp = requestedBoost > boost ? 85 : 175;
      boost += (requestedBoost - boost) * (1 - Math.exp(-(now - lastFrame) / ramp));
      if (!requestedBoost && boost < .02) {
        resetSpeed();
        return;
      }

      for (const animation of animations) animation.updatePlaybackRate(1 + boost);
      lastFrame = now;
      frame = requestAnimationFrame(easeSpeed);
    }

    window.addEventListener('scroll', () => {
      const distance = Math.abs(window.scrollY - lastScroll);
      lastScroll = window.scrollY;
      if (!distance || paused || !animations.length) return;

      const now = performance.now();
      requestedBoost = Math.min(3.5, requestedBoost + distance / 70);
      lastScrollTime = now;
      if (!frame) {
        lastFrame = now;
        frame = requestAnimationFrame(easeSpeed);
      }
    }, { passive: true });

    button.addEventListener('click', () => {
      paused = !paused;
      resetSpeed();
      for (const animation of animations) {
        if (paused) animation.pause();
        else animation.play();
      }
      button.textContent = paused ? 'Resume ambient motion' : 'Pause ambient motion';
    });

    motion.addEventListener('change', updateMotion);
    updateMotion();
  }
</script>
