<div data-ambient-background>
  <div class="field" aria-hidden="true">
    <span class="glow peach"></span>
    <span class="glow lilac"></span>
    <span class="glow mint"></span>
    <span class="glow blue"></span>
    <span class="glow gold"></span>
  </div>
  <button type="button" hidden>Pause ambient motion</button>
</div>

<style>
  [data-ambient-background] { position: relative; }
  .field {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: var(--sky, oklch(100% 0 0));
  }
  .field::before, .field::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .field::before {
    background: radial-gradient(ellipse at 82% 22% in oklch, oklch(96.54% 0.0168 56.2), oklch(none none none / 0) 70%);
  }
  .field::after {
    background:
      radial-gradient(ellipse at 76% 46% in oklch, oklch(42.9% 0.082 254), oklch(none none none / 0) 56%),
      radial-gradient(ellipse at 26% 91% in oklch, oklch(27.6% 0.065 254), oklch(none none none / 0) 65%);
    opacity: var(--moonlight, 0);
  }
  .field::before, .glow { opacity: calc(1 - var(--moonlight, 0)); }
  .glow {
    --blob-clearance: clamp(24px, 4vw, 84px);
    position: absolute;
    inline-size: max(86vw, 29rem);
    block-size: max(102%, 32rem);
    background: radial-gradient(
      ellipse closest-side in oklch,
      var(--light) 0%,
      color-mix(in oklch, var(--light) 78%, oklch(none none none / 0)) 32%,
      color-mix(in oklch, var(--light) 24%, oklch(none none none / 0)) 69%,
      oklch(none none none / 0) 100%
    );
  }
  .peach { --light: oklch(82.5% 0.132 44 / 0.733); inset: -29% auto auto -26%; }
  .lilac { --light: oklch(75.5% 0.167 303 / 0.753); inset: 6% auto auto 4%; }
  .mint { --light: oklch(82.9% 0.145 171 / 0.69); inset: -12% -27% auto auto; }
  .blue { --light: oklch(80.1% 0.111 254 / 0.769); inset: 42% auto auto 5%; }
  .gold { --light: oklch(89% 0.116 92 / 0.6); inset: 37% auto auto -29%; }

  button {
    position: absolute;
    inset: .55rem 0 auto auto;
    z-index: 1;
    border: 0;
    border-radius: .35rem;
    padding: .25rem .4rem;
    color: var(--muted-ink);
    background: oklch(none none none / 0);
    font-size: .75rem;
    cursor: pointer;
  }
  button:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: no-preference) {
    .field::before, .field::after, .glow { transition: opacity 550ms ease; }
  }
</style>

<script>
  function driftFrames(): Keyframe[] {
    const turn = 2 * Math.PI;
    const [start, bend, stretch, lift] = Array.from({ length: 4 }, () => Math.random() * turn);
    const steps = 100;
    // Leave room for the straight segment between sampled keyframes.
    const clearanceMargin = 1.04;

    return Array.from({ length: steps + 1 }, (_, index) => {
      const phase = (index % steps) * turn / steps;
      const angle = phase + start + .22 * Math.sin(2 * phase + bend);
      const x = Math.cos(angle);
      const y = Math.sin(angle);
      const width = 30 + 12 * Math.sin(3 * phase + stretch);
      const height = 24 + 10 * Math.sin(2 * phase + lift);
      return {
        transform: `translate(calc(${(x * width).toFixed(2)}% + var(--blob-clearance) * ${(x * clearanceMargin).toFixed(4)}), calc(${(y * height).toFixed(2)}% + var(--blob-clearance) * ${(y * clearanceMargin).toFixed(4)}))`,
      };
    });
  }

  const background = document.querySelector('[data-ambient-background]');
  if (background) {
    const button = background.querySelector('button')!;
    const glows = background.querySelectorAll('.glow');
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    let animations: Animation[] = [];
    let paused = false;
    let requestedBoost = 0;
    let playbackRate = 1;
    let wheelDirection = 1;
    let frame = 0;
    let lastFrame = 0;
    let lastWheelTime = 0;

    function applyMotion() {
      for (const animation of animations) {
        const time = animation.currentTime;
        if (playbackRate < 0 && typeof time === 'number' && time < 500) {
          const duration = animation.effect?.getComputedTiming().duration;
          // Rewind through a seamless loop without reaching the animation's start.
          if (typeof duration === 'number') animation.currentTime = time + duration;
        }
        animation.updatePlaybackRate(playbackRate);
      }
      document.dispatchEvent(new CustomEvent('ambient-motion-change', {
        detail: { paused, playbackRate },
      }));
    }

    function resetSpeed() {
      cancelAnimationFrame(frame);
      frame = 0;
      requestedBoost = 0;
      playbackRate = 1;
      applyMotion();
    }

    function updateMotion() {
      resetSpeed();
      for (const animation of animations) animation.cancel();
      animations = [];
      button.hidden = !motion.matches;
      if (!motion.matches) return;

      animations = Array.from(glows, glow => glow.animate(driftFrames(), {
        duration: 19000 + Math.random() * 12000,
        iterations: Infinity,
      }));
      if (paused) for (const animation of animations) animation.pause();
    }

    function easeSpeed(now: number) {
      if (now - lastWheelTime > 110) requestedBoost = 0;
      const elapsed = now - lastFrame;
      const target = requestedBoost ? wheelDirection * (1 + requestedBoost) : 1;
      const ramp = requestedBoost ? 40 : 175;
      playbackRate += (target - playbackRate) * (1 - Math.exp(-elapsed / ramp));
      if (!requestedBoost && Math.abs(playbackRate - 1) < .02) {
        resetSpeed();
        return;
      }

      applyMotion();
      lastFrame = now;
      frame = requestAnimationFrame(easeSpeed);
    }

    window.addEventListener('wheel', event => {
      if (paused || !animations.length || event.ctrlKey) return;

      const mode = event.deltaMode;
      const unit = mode === WheelEvent.DOM_DELTA_LINE ? 16
        : mode === WheelEvent.DOM_DELTA_PAGE ? window.innerHeight
        : 1;
      const distance = Math.hypot(event.deltaX, event.deltaY) * unit;
      if (!distance) return;

      const now = performance.now();
      wheelDirection = event.deltaY < 0 ? -1 : 1;
      requestedBoost = Math.min(9, requestedBoost + distance / 10);
      lastWheelTime = now;
      if (!frame) {
        lastFrame = now;
        frame = requestAnimationFrame(easeSpeed);
      }
    }, { passive: true });

    button.addEventListener('click', () => {
      paused = !paused;
      resetSpeed();
      for (const animation of animations) {
        if (paused) animation.pause();
        else animation.play();
      }
      button.textContent = paused ? 'Resume ambient motion' : 'Pause ambient motion';
    });

    motion.addEventListener('change', updateMotion);
    updateMotion();
  }
</script>
