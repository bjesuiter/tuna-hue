<dialog id="journey-image-preview" aria-label="Screenshot preview" closedby="any">
  <form method="dialog">
    <button class="glass-control" autofocus>Close <span aria-hidden="true">×</span></button>
  </form>
</dialog>

<style>
  dialog {
    max-inline-size: 100dvi;
    max-block-size: 100dvh;
    padding: 5px;
    border: 0;
    background: oklch(none none none / 0);
    color: var(--ink);
  }
  dialog:not([open]) { display: none; }
  dialog[open] { display: grid; gap: .5rem; }
  dialog:modal { overscroll-behavior: contain; }
  dialog::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: oklch(96% .01 259 / .96);
  }
  :global([data-lamp="off"]) dialog::backdrop { background: oklch(14% .03 258 / .96); }
  form { justify-self: end; }
  button {
    min-block-size: 2.75rem;
    padding-inline: .95rem;
    border-radius: 2rem;
    color: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  dialog > :global(img) {
    display: block;
    max-inline-size: calc(100dvi - 10px);
    max-block-size: calc(100dvh - 3.25rem - 10px);
    object-fit: contain;
  }
  @media (min-width: 48rem) {
    dialog {
      max-inline-size: calc(100dvi - 1rem);
      max-block-size: calc(100dvh - 1rem);
      padding: .75rem;
    }
    dialog > :global(img) {
      max-inline-size: calc(100dvi - 2.5rem);
      max-block-size: calc(100dvh - 6.5rem);
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#journey-image-preview');
  if (dialog && typeof dialog.showModal === 'function') {
    const image = new Image();
    dialog.append(image);
    dialog.addEventListener('close', () => {
      if (!dialog.open) image.removeAttribute('src');
    });

    document.addEventListener('click', event => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey ||
          event.shiftKey || event.altKey || dialog.open || !(event.target instanceof Element)) return;

      const link = event.target.closest<HTMLAnchorElement>('a[data-image-preview]');
      if (!link) return;

      image.alt = link.querySelector('img')?.alt ?? '';
      image.src = link.href;
      // Some browsers leave a pointer-activated link unfocused.
      link.focus({ preventScroll: true });
      dialog.showModal();
      event.preventDefault();
    });

    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', event => {
        if (event.target !== dialog) return;
        const { left, right, top, bottom } = dialog.getBoundingClientRect();
        if (event.clientX < left || event.clientX > right || event.clientY < top || event.clientY > bottom) {
          dialog.close();
        }
      });
    }
  }
</script>
