<dialog id="journey-image-preview" aria-label="Screenshot preview" closedby="any">
  <form method="dialog">
    <button class="pill" autofocus>Close <span aria-hidden="true">×</span></button>
  </form>
  <div class="preview-area">
    <div class="preview-frame"></div>
  </div>
</dialog>

<style>
  dialog {
    position: fixed;
    inset: 0;
    inline-size: auto;
    block-size: auto;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 5px;
    border: 0;
    background: oklch(none none none / 0);
    color: var(--ink);
  }
  dialog:not([open]) { display: none; }
  dialog[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--space-2xs);
  }
  dialog:modal { overscroll-behavior: contain; }
  dialog::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    /* Older engines do not inherit custom properties into ::backdrop. */
    background: var(--backdrop, oklch(96% 0.01 259 / 0.96));
  }
  form { justify-self: end; }
  button:focus-visible { outline-offset: -3px; }
  .preview-area {
    container-type: size;
    display: grid;
    place-items: center;
  }
  .preview-frame {
    position: relative;
    inline-size: min(100%, calc(100cqh * var(--preview-aspect, 1)));
    aspect-ratio: var(--preview-aspect, 1);
    overflow: hidden;
  }
  .preview-frame > :global(img) {
    position: absolute;
    inset-inline-start: var(--preview-left, 0%);
    inset-block-start: var(--preview-top, 0%);
    display: block;
    inline-size: var(--preview-width, 100%);
    max-inline-size: none;
  }
  @media (min-width: 48rem) {
    dialog {
      inline-size: fit-content;
      block-size: fit-content;
      max-inline-size: calc(100% - 1rem);
      max-block-size: calc(100dvh - 1rem);
      margin: auto;
      padding: var(--space-xs);
    }
    dialog[open] { grid-template-rows: auto auto; }
    .preview-area { container-type: normal; display: block; }
    .preview-frame { inline-size: auto; aspect-ratio: auto; overflow: visible; }
    .preview-frame > :global(img) {
      position: static;
      inline-size: auto;
      max-inline-size: 100%;
      max-block-size: calc(100dvh - 6.5rem);
      object-fit: contain;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#journey-image-preview');
  if (dialog && typeof dialog.showModal === 'function') {
    const area = dialog.querySelector('.preview-area')!;
    const frame = dialog.querySelector<HTMLElement>('.preview-frame')!;
    const image = new Image();
    frame.append(image);
    area.addEventListener('click', event => {
      if (event.target === area) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (!dialog.open) image.removeAttribute('src');
    });

    document.addEventListener('click', event => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey ||
          event.shiftKey || event.altKey || dialog.open || !(event.target instanceof Element)) return;

      const link = event.target.closest<HTMLAnchorElement>('a[data-image-preview]');
      if (!link) return;

      const imageWidth = Number(link.dataset.imageWidth);
      const imageHeight = Number(link.dataset.imageHeight);
      const [x, y, width, height] = link.dataset.previewBounds?.split(' ').map(Number)
        ?? [0, 0, imageWidth, imageHeight];
      frame.style.setProperty('--preview-aspect', String(width / height));
      frame.style.setProperty('--preview-left', `${-100 * x / width}%`);
      frame.style.setProperty('--preview-top', `${-100 * y / height}%`);
      frame.style.setProperty('--preview-width', `${100 * imageWidth / width}%`);
      image.alt = link.querySelector('img')?.alt ?? '';
      image.src = link.href;
      // Some browsers leave a pointer-activated link unfocused.
      link.focus({ preventScroll: true });
      dialog.showModal();
      event.preventDefault();
    });

    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', event => {
        if (event.target !== dialog) return;
        const { left, right, top, bottom } = dialog.getBoundingClientRect();
        if (event.clientX < left || event.clientX > right || event.clientY < top || event.clientY > bottom) {
          dialog.close();
        }
      });
    }
  }
</script>
